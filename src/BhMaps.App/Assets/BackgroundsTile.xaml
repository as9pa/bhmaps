<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A small landscape glyph: night sky, moon, hills. Used as the Backgrounds folder card thumbnail. -->
  <DrawingImage x:Key="BackgroundsTile">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#1E2A38">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,160,90" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#F2C94C">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="120,26" RadiusX="12" RadiusY="12" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2F6F4E">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M0,90 L40,45 L70,70 L100,35 L160,90 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

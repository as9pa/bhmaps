<UserControl x:Class="BhMaps.App.Views.Controls.SuggestBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             x:Name="Root"
             PreviewKeyDown="OnPreviewKeyDown">
  <Grid>
    <!-- The left padding is the canvas's: 10 to the icon, 15 of icon, 8 to the text, so what is typed starts
         clear of the icon instead of running under it. The other three are the style's own. -->
    <TextBox x:Name="Input"
             Padding="33,6,10,6"
             Style="{StaticResource FieldTextBox}"
             Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />

    <!-- Text3, the placeholder's own colour, because this icon belongs to the box rather than to a control that
         lights up: nothing about a search box hovers or disables. -->
    <controls:Icon Margin="11,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Text3Brush}"
                   Geometry="{StaticResource Icon.Search}"
                   Size="15" />

    <!-- Hit test off, so the placeholder never swallows the click that focuses the box. -->
    <TextBlock Margin="34,7,11,7" IsHitTestVisible="False" Text="{Binding Placeholder, ElementName=Root}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Popup x:Name="SuggestPopup"
           Width="{Binding ActualWidth, ElementName=Input}"
           AllowsTransparency="True"
           Placement="Bottom"
           PlacementTarget="{Binding ElementName=Input}"
           PopupAnimation="None"
           StaysOpen="False">
      <!-- Open while the box has focus, the user has not dismissed this text with Escape or Enter, and there is
           something to suggest. Written as triggers rather than a value set from code, so that the popup comes
           back on its own as soon as those three are true again. The empty-list trigger is last, and so wins. -->
      <Popup.Style>
        <Style TargetType="Popup">
          <Setter Property="IsOpen" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Input}" Value="True" />
                <Condition Binding="{Binding IsDismissed, ElementName=Root}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsOpen" Value="True" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Suggestions.Count, ElementName=Root}" Value="0">
              <Setter Property="IsOpen" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Popup.Style>

      <Border Margin="0,4,0,0"
              Padding="4"
              Background="{StaticResource Surface2Brush}"
              BorderBrush="{StaticResource Line2Brush}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius}">
        <ListBox x:Name="SuggestList"
                 MaxHeight="240"
                 ItemsSource="{Binding Suggestions, ElementName=Root}"
                 Style="{StaticResource TileListBox}"
                 Tag="{Binding ChooseItem, ElementName=Root}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource TileListBoxItem}">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource TileBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- The template has its own name scope, so the command comes off the ListBox's Tag, which is the
                   one binding that crosses into the popup's separate visual tree. -->
              <Border Padding="8,5" Background="Transparent">
                <Border.InputBindings>
                  <MouseBinding Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                MouseAction="LeftClick" />
                </Border.InputBindings>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>
  </Grid>
</UserControl>

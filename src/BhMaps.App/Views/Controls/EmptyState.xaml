<UserControl x:Class="BhMaps.App.Views.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             x:Name="Root"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
  <!-- 3.0: every page that has nothing to show says so the same way. One sentence, and at most the one action
       that fills the page; 420 is the width the dialogs read at, which is as wide as a sentence should run. -->
  <StackPanel MaxWidth="420">
    <!-- 3.9: a 32 px line icon above the sentence, in Text3. The search glyph when a search caused the empty
         list (the action is Clear search), the picture glyph otherwise; a page can name its own with Glyph. -->
    <controls:Icon Margin="0,0,0,12"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource Text3Brush}"
                   Size="32">
      <controls:Icon.Style>
        <Style TargetType="controls:Icon">
          <Setter Property="Geometry" Value="{Binding Glyph, ElementName=Root, TargetNullValue={StaticResource Icon.Image}}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="Clear search">
              <Setter Property="Geometry" Value="{StaticResource Icon.Search}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </controls:Icon.Style>
    </controls:Icon>

    <TextBlock FontSize="{StaticResource FontBody}"
               Foreground="{StaticResource Text2Brush}"
               Text="{Binding Text, ElementName=Root}"
               TextAlignment="Center"
               TextWrapping="Wrap" />

    <!-- 3.9: one quieter line under the sentence, only when there is one. -->
    <TextBlock Margin="0,4,0,0"
               FontSize="{StaticResource FontBody}"
               Foreground="{StaticResource Text3Brush}"
               TextAlignment="Center"
               TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Text" Value="{Binding Hint, ElementName=Root}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="Clear search">
              <Setter Property="Text" Value="Try a shorter search or another filter." />
            </DataTrigger>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- Its own label drives the visibility, so a state with no action takes the line back rather than leaving
         a gap (the pattern DialogWindow's detail line uses). -->
    <Button Margin="{StaticResource Gap12}"
            HorizontalAlignment="Center"
            Command="{Binding ActionCommand, ElementName=Root}"
            Content="{Binding ActionText, ElementName=Root}">
      <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
          <Style.Triggers>
            <Trigger Property="Content" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
    </Button>
  </StackPanel>
</UserControl>

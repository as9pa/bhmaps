<UserControl x:Class="BhMaps.App.Views.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
  <!-- 3.0: every page that has nothing to show says so the same way. One sentence, and at most the one action
       that fills the page; 420 is the width the dialogs read at, which is as wide as a sentence should run. -->
  <StackPanel MaxWidth="420">
    <TextBlock FontSize="{StaticResource FontBody}"
               Foreground="{StaticResource Text2Brush}"
               Text="{Binding Text, ElementName=Root}"
               TextAlignment="Center"
               TextWrapping="Wrap" />

    <!-- Its own label drives the visibility, so a state with no action takes the line back rather than leaving
         a gap (the pattern DialogWindow's detail line uses). -->
    <Button Margin="{StaticResource Gap12}"
            HorizontalAlignment="Center"
            Command="{Binding ActionCommand, ElementName=Root}"
            Content="{Binding ActionText, ElementName=Root}">
      <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
          <Style.Triggers>
            <Trigger Property="Content" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
    </Button>
  </StackPanel>
</UserControl>

<UserControl x:Class="BhMaps.App.Views.Controls.StatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             AutomationProperties.Name="Status"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
  <UserControl.Resources>
    <!-- The links the strip offers. A link here is the app's plain button with the text's own weight and rule on
         it: never a colour, because the dot is the only coloured thing on the strip. -->
    <Style x:Key="StripLink" TargetType="Button" BasedOn="{StaticResource PlainButton}">
      <Setter Property="Padding" Value="{StaticResource Gap8}" />
    </Style>
    <Style x:Key="StripLinkText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Resources>

  <Border Background="{StaticResource Surface2Brush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius}"
          Padding="{StaticResource Gap12}">
    <DockPanel>

      <!-- The dot, and the only thing on the strip that carries a colour. The halo is a second circle under it,
           twice the width at a quarter of the opacity, so a running line reads as running from across the room
           without anything moving. -->
      <Grid Width="12" Height="12" Margin="0,0,12,0" DockPanel.Dock="Left" VerticalAlignment="Center">
        <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" Opacity="0.25">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Running">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <Ellipse Width="6" Height="6">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Text3Brush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Running">
                  <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Done">
                  <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Undone">
                  <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                  <Setter Property="Fill" Value="{StaticResource MissingFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Cancelled">
                  <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
      </Grid>

      <!-- Last in the row and first in the markup, because a DockPanel gives the docked children the edges in the
           order they are declared and the text takes what is left. -->
      <Button DockPanel.Dock="Right"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              AutomationProperties.Name="Dismiss"
              Command="{Binding DismissCommand}"
              Style="{StaticResource PlainButton}"
              ToolTip="Dismiss"
              Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}"
              controls:Icon.Glyph="{StaticResource Icon.X}" />

      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <Button Command="{Binding CancelCommand}"
                Style="{StaticResource StripLink}"
                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource StripLinkText}" Text="Cancel" />
        </Button>
        <Button Command="{Binding UndoCommand}"
                Style="{StaticResource StripLink}"
                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource StripLinkText}" Text="Undo" />
        </Button>
        <Button Command="{Binding RetryCommand}"
                Style="{StaticResource StripLink}"
                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource StripLinkText}" Text="Retry" />
        </Button>
      </StackPanel>

      <!-- Two lines at most: the strip is a line, not a paragraph, and a reason longer than that belongs in the
           failures dialog. MaxHeight rather than trimming, because a cut-off word says less than a clipped one.
           The automation name is the text itself, so a reader announces the line rather than the control. -->
      <TextBlock VerticalAlignment="Center"
                 MaxHeight="36"
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="{Binding Text}"
                 FontSize="{StaticResource FontBody}"
                 Foreground="{StaticResource TextBrush}"
                 Text="{Binding Text}"
                 TextTrimming="None"
                 TextWrapping="Wrap" />
    </DockPanel>
  </Border>
</UserControl>

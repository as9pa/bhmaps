<UserControl x:Class="BhMaps.App.Views.Controls.SizePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             AutomationProperties.Name="Size">
  <UserControl.Resources>
    <!-- One segment of the pill. The checked look is ChipToggle's: the accent behind a Bg glyph, so the chosen
         size reads at a glance without a label under it. -->
    <Style x:Key="SizeSegment" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource RadiusPill}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Height="{StaticResource ActionHeight}"
          Background="{StaticResource Surface2Brush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource RadiusPill}">
    <StackPanel Orientation="Horizontal">
      <ToggleButton x:Name="LargeSegment"
                    AutomationProperties.Name="Large"
                    Style="{StaticResource SizeSegment}"
                    Tag="Large"
                    ToolTip="Large tiles"
                    Checked="OnSegmentChecked"
                    Unchecked="OnSegmentUnchecked">
        <controls:Icon Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Geometry="{StaticResource Icon.GridLarge}" Size="16" />
      </ToggleButton>
      <ToggleButton x:Name="MediumSegment"
                    AutomationProperties.Name="Medium"
                    Style="{StaticResource SizeSegment}"
                    Tag="Medium"
                    ToolTip="Medium tiles"
                    Checked="OnSegmentChecked"
                    Unchecked="OnSegmentUnchecked">
        <controls:Icon Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Geometry="{StaticResource Icon.GridMedium}" Size="16" />
      </ToggleButton>
      <ToggleButton x:Name="SmallSegment"
                    AutomationProperties.Name="Small"
                    Style="{StaticResource SizeSegment}"
                    Tag="Small"
                    ToolTip="Small tiles"
                    Checked="OnSegmentChecked"
                    Unchecked="OnSegmentUnchecked">
        <controls:Icon Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Geometry="{StaticResource Icon.GridSmall}" Size="16" />
      </ToggleButton>
    </StackPanel>
  </Border>
</UserControl>

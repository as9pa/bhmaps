<UserControl x:Class="BhMaps.App.Views.Controls.Icon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
  <!-- Laid out in the canvas's own 24 unit box and scaled from there by a LayoutTransform, so the artboard's
       stroke width of 2 is scaled with the drawing exactly as the SVG scales it, and the control still measures
       Size by Size. Stroke rather than Fill, because these are line icons, and the brush is the Foreground the
       host hands down: a button's hover, the sidebar's current row and a disabled action all reach it that way. -->
  <Path Width="24"
        Height="24"
        Data="{Binding Geometry, ElementName=Root}"
        SnapsToDevicePixels="True"
        Stretch="None"
        Stroke="{Binding Foreground, ElementName=Root}"
        StrokeEndLineCap="Round"
        StrokeLineJoin="Round"
        StrokeStartLineCap="Round"
        StrokeThickness="2">
    <Path.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Scale, ElementName=Root}" ScaleY="{Binding Scale, ElementName=Root}" />
    </Path.LayoutTransform>
  </Path>
</UserControl>

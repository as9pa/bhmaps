<UserControl x:Class="BhMaps.App.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:converters="clr-namespace:BhMaps.App.Converters"
             x:Name="Root">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />
  </UserControl.Resources>
  <Grid Height="56">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Empty on every page but pack detail, where it is the back chevron; with no content it measures to zero
         and the title stays where it was. -->
    <ContentPresenter Grid.Column="0"
                      Margin="0,0,4,0"
                      VerticalAlignment="Center"
                      Content="{Binding Leading, ElementName=Root}" />

    <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               FontSize="22"
               FontWeight="SemiBold"
               Text="{Binding Title, ElementName=Root}" />

    <!-- The busy line and the done line belong to the shell, not to the page, so this one cell binds past the
         page view model to the window's MainViewModel (decision D11). Only one of the two is ever visible. -->
    <Grid Grid.Column="2"
          Margin="16,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>

              <!-- Last, so it wins over the one above when both match. -->
              <DataTrigger Binding="{Binding GameFolderMissing}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="{Binding ProgressText}" />
        <Button Margin="8,0,0,0" Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource PlainButton}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <!-- Visible only when the shell is idle, has something to report, and has a folder to report it about;
               triggers test equality, so the three ways of having nothing to show are what switch it off. -->
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DoneText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding GameFolderMissing}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="{Binding DoneText}" />

        <!-- Only beside a line a game write left: a library-only line has no snapshot behind it, and Undo there
             would put back an older write the line says nothing about. -->
        <Button Margin="8,0,0,0"
                Command="{Binding UndoCommand}"
                Content="Undo"
                IsEnabled="{Binding CanUndo}"
                Style="{StaticResource PlainButton}"
                Visibility="{Binding DoneUndoable, Converter={StaticResource BoolToVis}}" />

        <!-- Spec 2.6 4.3: a plain copy has no snapshot behind it and offers the target instead of Undo. -->
        <Button Margin="8,0,0,0"
                Command="{Binding DoneActionCommand}"
                Content="{Binding DoneActionText}"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                Style="{StaticResource PlainButton}"
                Visibility="{Binding HasDoneAction, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>

    <ContentPresenter Grid.Column="3" VerticalAlignment="Center" Content="{Binding Actions, ElementName=Root}" />

    <!-- The page's own menu (3.0), after the actions and only on a page that hands one over: the actions a page
         offers but does not want a button for. TileMenus.OpensMenu walks up from the button for the first element
         that owns a ContextMenu, so the menu hangs on this Grid rather than on the button, and it reads its lines
         off PlacementTarget.Tag rather than through the tiles' TileMenu resource, whose ItemsSource names the
         MenuItems a tile view model carries and a page view model does not. -->
    <Grid Grid.Column="4"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Tag="{Binding PageMenu, ElementName=Root}"
          Visibility="{Binding PageMenu, ElementName=Root, Converter={StaticResource NullToVis}}">
      <Grid.ContextMenu>
        <ContextMenu ItemContainerStyle="{StaticResource TileMenuItem}"
                     ItemsSource="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     Style="{StaticResource TileContextMenu}" />
      </Grid.ContextMenu>
      <Button AutomationProperties.Name="More"
              controls:Icon.Glyph="{StaticResource Icon.Dots}"
              controls:TileMenus.OpensMenu="True"
              Style="{StaticResource PlainButton}"
              ToolTip="More" />
    </Grid>
  </Grid>
</UserControl>

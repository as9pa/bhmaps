<Window x:Class="BhMaps.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BhMaps" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BgBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Auto, not a fixed width: ColumnDefinition.Width is a GridLength and SidebarWidth is a Double, so the
           token is applied to the sidebar itself and the column takes its size from it. -->
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The sidebar's contents are Task 23. -->
    <Border Grid.Column="0"
            Width="{StaticResource SidebarWidth}"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,1,0" />

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
  </Grid>
</Window>

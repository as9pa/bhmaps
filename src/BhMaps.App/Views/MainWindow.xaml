<Window x:Class="BhMaps.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BhMaps.App.Converters"
        xmlns:vm="clr-namespace:BhMaps.App.ViewModels"
        xmlns:views="clr-namespace:BhMaps.App.Views"
        Title="BhMaps" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Background="#F7F7F7">
  <Window.Resources>
    <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate DataType="{x:Type vm:FolderDetailViewModel}">
      <views:FolderDetailView />
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#ECECEC" BorderBrush="#D6D6D6" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,4" Margin="0,0,6,0" />
          <Button Content="Reset All" Command="{Binding ResetAllCommand}" Padding="12,4" Margin="0,0,6,0" />
          <Button Content="Launch Brawlhalla" Command="{Binding LaunchGameCommand}" Padding="12,4" Margin="0,0,6,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="0,0,8,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,2" Margin="0,0,12,0"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#666666" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="260" Padding="10" Background="White" BorderBrush="#D6D6D6" BorderThickness="0,0,1,0"
            IsEnabled="{Binding IsNotBusy}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Packs" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
          <Button Content="Apply All" Command="{Binding ApplyAllCommand}" Margin="2" Padding="6,4" />
          <Button Content="Open Folder" Command="{Binding OpenPackFolderCommand}" Margin="2" Padding="6,4" />
        </UniformGrid>
        <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Right" Foreground="#888888" Margin="8,0,0,0" Text="{Binding FileCount, StringFormat='{}{0} files'}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid IsEnabled="{Binding IsNotBusy}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding Detail, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
        <ItemsControl ItemsSource="{Binding Folders}" Margin="6">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="220" Margin="6" Padding="8" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                  <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" ToolTip="Open folder details">
                    <StackPanel>
                      <Border Height="120" Background="#1E1E1E" CornerRadius="4">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,2" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" Foreground="#888888" FontSize="11" Margin="0,0,0,4" />
                  <Border Background="{Binding State, Converter={StaticResource StatusToBrush}}" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                  <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCommand}" Padding="8,2" Margin="4,0,0,0" />
                    <Button Content="Apply from &#x25BE;" Padding="8,2" IsEnabled="{Binding HasApplyOptions}" Click="ApplyFrom_Click">
                      <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ApplyFromMenu}" ItemsSource="{Binding ApplyFromOptions}">
                          <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                              <Setter Property="Header" Value="{Binding Name}" />
                              <Setter Property="Command" Value="{Binding ApplyCommand}" />
                            </Style>
                          </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ContentControl Content="{Binding Detail}"
                      Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
    </Grid>
  </DockPanel>
</Window>

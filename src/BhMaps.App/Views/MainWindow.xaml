<Window x:Class="BhMaps.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BhMaps.App.Converters"
        Title="BhMaps" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Background="#F7F7F7">
  <Window.Resources>
    <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#ECECEC" BorderBrush="#D6D6D6" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,4" Margin="0,0,6,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="0,0,8,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,2" Margin="0,0,12,0"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#666666" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="260" Padding="10" Background="White" BorderBrush="#D6D6D6" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Packs" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Right" Foreground="#888888" Text="{Binding FileCount, StringFormat='{}{0} files'}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsNotBusy}">
      <ItemsControl ItemsSource="{Binding Folders}" Margin="6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="220" Margin="6" Padding="8" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
              <StackPanel>
                <Border Height="120" Background="#1E1E1E" CornerRadius="4">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,2" />
                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" Foreground="#888888" FontSize="11" Margin="0,0,0,4" />
                <Border Background="{Binding State, Converter={StaticResource StatusToBrush}}" CornerRadius="3" Padding="6,2">
                  <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>

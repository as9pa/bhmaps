<Window x:Class="BhMaps.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
        Title="BhMaps" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BgBrush}">
  <!-- Nothing on a page triggers a rescan, so the keyboard does; Ctrl+1..5 are the five tabs (addendum A).
       Ctrl+K is in the code-behind: it navigates and then focuses, which a command cannot do. Ctrl+Z and Escape
       are the status strip's two links (3.0); both commands say no when the strip is not offering them, and a
       page that answers Escape itself is asked first, because its own binding sits nearer the focus than this
       one. -->
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RescanFromKeyCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Status.UndoCommand}" />
    <KeyBinding Key="Escape" Command="{Binding Status.CancelCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateMapsCommand}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateBackgroundsCommand}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigatePlatformsCommand}" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigatePacksCommand}" />
    <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateSettingsCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Addendum A: brand, five tabs, and the game line at the right. 44 px with a hairline under it. -->
    <Border Grid.Row="0"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="16,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center"
                   FontSize="{StaticResource FontEmphasis}"
                   FontWeight="SemiBold"
                   Text="BhMaps" />

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Command="{Binding NavigateMapsCommand}" Content="Maps" Style="{StaticResource TopBarTab}" Tag="{Binding Maps}" />
          <Button Command="{Binding NavigateBackgroundsCommand}" Content="Backgrounds" Style="{StaticResource TopBarTab}" Tag="{Binding Backgrounds}" />
          <Button Command="{Binding NavigatePlatformsCommand}" Content="Platforms" Style="{StaticResource TopBarTab}" Tag="{Binding Platforms}" />
          <Button Command="{Binding NavigatePacksCommand}" Content="Packs" Style="{StaticResource TopBarTab}" Tag="{Binding Packs}" />
          <Button Command="{Binding NavigateSettingsCommand}" Content="Settings" Style="{StaticResource TopBarTab}" Tag="{Binding SettingsPage}" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">

          <!-- Spec 7.3: one quiet line, only for a newer release that has not been waved away. It navigates to
               the Settings row that offers the download; nothing here downloads or restarts anything. -->
          <StackPanel Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Visibility="{Binding ShowUpdateLine, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding OpenUpdateCommand}"
                    Content="New update available"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Foreground="{StaticResource Text2Brush}"
                    Style="{StaticResource PlainButton}" />
            <Button Margin="2,0,0,0"
                    AutomationProperties.Name="Dismiss the update notice"
                    Command="{Binding DismissUpdateCommand}"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PlainButton}"
                    ToolTip="Dismiss"
                    controls:Icon.Glyph="{StaticResource Icon.X}" />
          </StackPanel>

          <!-- Spec 2.8: writes the game back to what the app says is on. It stands whether the game is up or
               down, because the write path already handles a running game; only the missing folder takes it
               away, as it takes away every other write. The glyph alone in a square (3.0): the top bar had two
               words of button before the game line, and the tooltip and the accessible name still say Refresh.
               The left padding is the glyph's own 7 px right margin given back, so it sits in the middle. -->
          <Button Width="{StaticResource ActionHeight}"
                  Height="{StaticResource ActionHeight}"
                  Margin="0,0,12,0"
                  Padding="7,0,0,0"
                  AutomationProperties.Name="Refresh"
                  Command="{Binding RefreshGameCommand}"
                  ToolTip="Refresh: re-apply what is on, restore missing files, redraw the map-select thumbnails"
                  controls:Icon.Glyph="{StaticResource Icon.Refresh}">
            <Button.Style>
              <!-- Outlined rather than plain (3.0): it writes into the game folder, and a write does not read as
                   quietly as Launch beside it. Disabled rather than gone while the folder is missing (3.0): the
                   pages say the folder is missing, so the top bar only has to stop being clickable. -->
              <Style BasedOn="{StaticResource OutlineButton}" TargetType="Button">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding GameFolderMissing}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>

          <!-- Two states, one at a time: the game is up or the game is down. A missing game folder is the pages'
               news now (3.0), not the top bar's; here it only takes Launch away. -->
          <Grid VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameRunning}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource TextBrush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="Brawlhalla running" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameRunning}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource Line2Brush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="Brawlhalla not running" />
              <Button Margin="8,0,0,0"
                      Command="{Binding LaunchGameCommand}"
                      Content="Launch"
                      controls:Icon.Glyph="{StaticResource Icon.Play}">
                <Button.Style>
                  <!-- Nothing to launch without the folder the game lives in. -->
                  <Style BasedOn="{StaticResource PlainButton}" TargetType="Button">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding GameFolderMissing}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 3.0: the first run's one line, between the top bar and the page. A library with no pack at all cannot
         reset anything, so the offer follows the user around rather than waiting on the Packs page; it goes by
         itself the moment a pack exists, and the row gives its height back with it. Built like the strip, minus
         the dot: nothing is running here, it is an offer. -->
    <Border Grid.Row="1"
            Margin="24,16,24,0"
            AutomationProperties.Name="First run"
            Background="{StaticResource Surface2Brush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            IsEnabled="{Binding IsNotBusy}"
            Padding="{StaticResource Gap12}"
            Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Command="{Binding CaptureDefaultsCommand}"
                Style="{StaticResource StripLink}">
          <TextBlock Style="{StaticResource StripLinkText}" Text="Capture" />
        </Button>
        <TextBlock VerticalAlignment="Center"
                   FontSize="{StaticResource FontBody}"
                   Foreground="{StaticResource TextBrush}"
                   Text="No Default pack yet. Capture it to have something to reset to."
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" />

    <!-- 3.0: the one place the shell says anything, at the foot of the content area. The side gutter is the
         pages' own 24 px, so the strip's left edge is the page content's; it collapses when there is nothing to
         say, and the row gives the height back to the page with it. -->
    <controls:StatusStrip Grid.Row="3" Margin="24,0,24,16" DataContext="{Binding Status}" />
  </Grid>
</Window>

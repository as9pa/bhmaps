<Window x:Class="BhMaps.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="14">
    <TextBlock x:Name="MessageText" Margin="0,0,0,6" TextWrapping="Wrap" />
    <TextBox x:Name="ValueBox" Margin="0,0,0,12" Padding="4" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="OK" Width="84" IsDefault="True" Click="Ok_Click" Margin="0,0,6,0" />
      <Button Content="Cancel" Width="84" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>

<Window x:Class="BhMaps.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
  <!-- Title, message and initial value are written by the code-behind, so the two named elements keep their names. -->
  <StackPanel Margin="24">
    <TextBlock x:Name="MessageText"
               Foreground="{StaticResource Text2Brush}"
               TextWrapping="Wrap" />
    <!-- The message is the field's label, so a screen reader reads the question rather than nothing. -->
    <TextBox x:Name="ValueBox"
             Margin="0,10,0,0"
             AutomationProperties.Name="{Binding Text, ElementName=MessageText}"
             Style="{StaticResource FieldTextBox}" />
    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <!-- No command: IsCancel closes with false, which the caller reads as cancelled, and Escape does the same. -->
      <Button Margin="0,0,8,0"
              Content="Cancel"
              FocusVisualStyle="{StaticResource DialogFocusRing}"
              IsCancel="True"
              Style="{StaticResource PlainButton}" />
      <Button Click="Ok_Click"
              Content="OK"
              FocusVisualStyle="{StaticResource DialogFocusRing}"
              IsDefault="True"
              Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </StackPanel>
</Window>

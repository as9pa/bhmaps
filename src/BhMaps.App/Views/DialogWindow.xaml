<Window x:Class="BhMaps.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        KeyDown="OnKeyDown">
  <!-- Title and DataContext are set by the code-behind, from the DialogViewModel it is handed. -->
  <!-- 470 wide leaves the text column 420: 470 less the border and the 24 padding on each side. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Page-title weight (spec 7.1), in Missing's colour when the news is an error and nowhere else. -->
    <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsError}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The message is read, not typed: the field template without its fill, border or padding, so the text
         can still be selected and copied out of a failure the app is only reporting. Out of the tab order
         because it is not an input; Escape and Enter belong to the buttons. -->
    <Style x:Key="DialogMessage" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Its own Text drives the visibility, so a dialog without a detail takes the line back rather than
         leaving a gap (the pattern the background editor's hints use). -->
    <Style x:Key="DialogDetail" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <!-- WindowStyle=None, so this border is the window's own edge: the same 1 px line and radius as a card. -->
  <Border BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius}">
    <StackPanel Margin="24">
      <TextBlock Style="{StaticResource DialogTitle}" Text="{Binding Title}" />
      <TextBox Margin="0,10,0,0"
               Style="{StaticResource DialogMessage}"
               Text="{Binding Message, Mode=OneWay}" />
      <TextBlock Style="{StaticResource DialogDetail}" Text="{Binding Detail}" />
      <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
        <!-- No command: IsCancel closes with false, which Confirm reads as declined, and Escape does the same.
             The one-button kinds hide it, so there the code-behind gives Escape its meaning instead. -->
        <Button Margin="0,0,8,0"
                Content="Cancel"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsCancel="True"
                Style="{StaticResource PlainButton}"
                Visibility="{Binding HasCancel, Converter={StaticResource BoolToVis}}" />
        <Button x:Name="OkButton"
                Click="Ok_Click"
                Content="OK"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsDefault="True"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>

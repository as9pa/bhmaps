<Window x:Class="BhMaps.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import into a pack" Width="1000" Height="660" MinWidth="780" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Source folder" VerticalAlignment="Center" Margin="0,0,8,4" />
      <TextBox Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" Padding="3" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
        <Button Content="Browse..." Command="{Binding BrowseCommand}" Padding="10,2" Margin="0,0,4,0" />
        <Button Content="Scan" Command="{Binding ScanCommand}" Padding="10,2" />
      </StackPanel>
      <TextBlock Grid.Row="1" Text="Pack name" VerticalAlignment="Center" Margin="0,0,8,4" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" Padding="3" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding NameError}" Foreground="#C62828" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Text="Scanning..." Foreground="#555555" VerticalAlignment="Center"
                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#555555" />
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Import" Command="{Binding ImportCommand}" Width="100" IsDefault="True" Margin="0,0,6,0" />
      <Button Content="Cancel" Width="100" IsCancel="True" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding RouteText}" Value="Ambiguous">
              <Setter Property="Background" Value="#FFF8E1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RouteText}" Value="Unmatched">
              <Setter Property="Background" Value="#EEEEEE" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Conflict}" Value="True">
              <Setter Property="Background" Value="#FFE0E0" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Include" Width="64">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRouted}" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" />
        <DataGridTextColumn Header="Route" Binding="{Binding RouteText}" Width="90" />
        <DataGridTemplateColumn Header="Target folder" Width="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.AllFolders, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedItem="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Candidates" Binding="{Binding CandidatesText}" Width="150" />
        <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

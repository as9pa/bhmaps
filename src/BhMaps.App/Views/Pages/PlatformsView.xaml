<UserControl x:Class="BhMaps.App.Views.Pages.PlatformsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="QuietNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <!-- The page's empty state, shown in place of everything else when the catalog holds no maps. -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasMaps}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The hint beside a disabled Reset. Nothing to say means nothing drawn. -->
    <Style x:Key="ResetHintText" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResetHint}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One half of the segmented control. Checked is the filled state; keyboard focus is the same 60 % ring the
         tiles and the sidebar rows wear (spec 7.8), drawn in Bg on the filled half so it stays visible. -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <ControlTemplate.Resources>
              <!-- As in the theme's buttons: the implicit TextBlock style reaches the ContentPresenter's own
                   TextBlock and would beat the segment's Foreground, so the string is templated instead. -->
              <DataTemplate DataType="{x:Type sys:String}">
                <TextBlock Text="{Binding}"
                           FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" />
              </DataTemplate>
            </ControlTemplate.Resources>
            <Grid>
              <!-- 4 is the 6 of the container less its 2 px padding, so the two curves are concentric. -->
              <Border x:Name="Chrome"
                      Background="Transparent"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="Ring"
                      BorderBrush="{StaticResource TextBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      IsHitTestVisible="False"
                      Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TextBrush}" />
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource BgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The set in the game wears the ring; the tile the keyboard is in lifts to Surface2, so the two states
         never read as the same thing. -->
    <Style x:Key="SetTileBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
      <Setter Property="Padding" Value="8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding InGame}" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        </DataTrigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Without these a screen reader reads the view model's type name off every generated container, which is
         what the automation tree showed before they were added. -->
    <Style x:Key="TileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding PackName}" />
    </Style>

    <Style x:Key="FileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding RelativePath}" />
    </Style>

    <Style x:Key="MapRowContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
    </Style>

    <!-- One tile: the pack's platforms over the map's current background, its name, and the apply. The picture is
         an ImageBrush so it keeps the tile's corners; the Tile colour behind it is what an empty slot shows. -->
    <DataTemplate x:Key="SetTile">
      <Border Margin="0,0,12,12" Style="{StaticResource SetTileBorder}">
        <StackPanel>
          <Border Width="{Binding TileWidth}"
                  Height="{Binding TileHeight}"
                  Background="{StaticResource TileBrush}"
                  CornerRadius="{StaticResource Radius}">
            <Border CornerRadius="{StaticResource Radius}">
              <Border.Background>
                <ImageBrush ImageSource="{Binding Preview}" Stretch="Uniform" />
              </Border.Background>
            </Border>
          </Border>
          <Grid Margin="2,10,2,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0"
                  Width="11"
                  Height="9"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Data="M 0,4 L 3.5,8 L 10,1"
                  Stretch="None"
                  Stroke="{StaticResource TextBrush}"
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="1.5"
                  Visibility="{Binding InGame, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding PackName}"
                       TextTrimming="CharacterEllipsis" />
            <!-- CanWrite rather than IsNotBusy: applying a set writes into the game folder (spec 7.8). -->
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Command="{Binding UseCommand}"
                    Content="Use"
                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource TileButton}" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One platform file of the selected map: its thumbnail, its path, and where the art came from. -->
    <DataTemplate x:Key="FileRow">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="64"
                Height="36"
                Background="{StaticResource TileBrush}"
                CornerRadius="{StaticResource Radius}">
          <Border CornerRadius="{StaticResource Radius}">
            <Border.Background>
              <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform" />
            </Border.Background>
          </Border>
        </Border>
        <TextBlock Grid.Column="1"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource MonoText}"
                   Text="{Binding RelativePath}"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Border Style="{StaticResource StateTagBorder}" Visibility="{Binding ShowTag, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SourceText}" />
          </Border>
          <Border Style="{StaticResource MissingTagBorder}" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Missing" />
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>

    <!-- One row of All maps: the map's name and the same tiles, smaller. -->
    <DataTemplate x:Key="MapRow">
      <StackPanel Margin="0,0,0,20">
        <TextBlock FontWeight="Medium" Text="{Binding DisplayName}" />
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource QuietNote}"
                   Text="{Binding NoSetsText}"
                   Visibility="{Binding ShowNoSets, Converter={StaticResource BoolToVis}}" />
        <ItemsControl Margin="0,10,0,0"
                      Focusable="False"
                      ItemContainerStyle="{StaticResource TileContainer}"
                      ItemTemplate="{StaticResource SetTile}"
                      ItemsSource="{Binding Sets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <controls:PageHeader DockPanel.Dock="Top" Title="Platforms">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ResetHintText}" Text="{Binding ResetHint}" />
          <!-- Off while any operation runs and while the game folder is missing, like the tiles' Use. WPF ands
               this with the command's CanExecute, so the no-Default-pack disable still holds. -->
          <Button Margin="8,0,0,0"
                  Command="{Binding ResetCommand}"
                  Content="Reset to default (this map)"
                  IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource OutlineButton}"
                  ToolTip="{Binding ResetTooltip}"
                  ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid>
      <TextBlock Margin="0,8,0,0"
                 VerticalAlignment="Top"
                 Style="{StaticResource EmptyStateText}"
                 Text="{Binding EmptyText}" />

      <DockPanel Visibility="{Binding HasMaps, Converter={StaticResource BoolToVis}}">
        <Border DockPanel.Dock="Top"
                Margin="0,4,0,16"
                HorizontalAlignment="Left"
                Padding="2"
                Style="{StaticResource CardBorder}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Command="{Binding ShowMapCommand}"
                         Content="{Binding SelectedMapName}"
                         GroupName="PlatformsSegment"
                         IsChecked="{Binding ShowSelectedMap, Mode=OneWay}"
                         Style="{StaticResource SegmentRadio}" />
            <RadioButton Command="{Binding ShowAllCommand}"
                         Content="All maps"
                         GroupName="PlatformsSegment"
                         IsChecked="{Binding ShowAllMaps, Mode=OneWay}"
                         Style="{StaticResource SegmentRadio}" />
          </StackPanel>
        </Border>

        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowSelectedMap, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionHeaderText}" Text="Sets" />
              <TextBlock Margin="0,10,0,0"
                         Style="{StaticResource QuietNote}"
                         Text="{Binding SetsEmptyText}"
                         Visibility="{Binding ShowNoSets, Converter={StaticResource BoolToVis}}" />
              <ItemsControl Margin="0,10,0,0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource TileContainer}"
                            ItemTemplate="{StaticResource SetTile}"
                            ItemsSource="{Binding Sets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Margin="0,12,0,0" Style="{StaticResource SectionHeaderText}" Text="{Binding FilesHeader}" />
              <ItemsControl Margin="0,10,0,0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource FileContainer}"
                            ItemTemplate="{StaticResource FileRow}"
                            ItemsSource="{Binding Files}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Pixel scrolling keeps the wheel smooth while the rows still virtualise, which matters at 60-odd
               maps with several tiles each. -->
          <ItemsControl Focusable="False"
                        ItemContainerStyle="{StaticResource MapRowContainer}"
                        ItemTemplate="{StaticResource MapRow}"
                        ItemsSource="{Binding AllMaps}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        Visibility="{Binding ShowAllMaps, Converter={StaticResource BoolToVis}}">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>

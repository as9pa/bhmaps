<UserControl x:Class="BhMaps.App.Views.Pages.BackgroundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:pages="clr-namespace:BhMaps.App.ViewModels.Pages"
             PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- On the container and not on the tile: the tile is a Grid, and the name a generated item announces is the
         container's, which without this is the view model's type name. -->
    <Style x:Key="TileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    </Style>

    <!-- One picture on the page's grid (spec 4). The whole tile carries the menu, so a right click anywhere on
         it, the menu button and Shift+F10 open the same lines. -->
    <DataTemplate x:Key="PictureTile">
      <!-- The tile itself takes focus, so the ring is visible on it as well as on its actions (spec 7.8). It has
           no action of its own, so it is not a button. -->
      <Grid x:Name="Tile"
            Margin="0,0,12,12"
            AutomationProperties.Name="{Binding Title}"
            ContextMenu="{StaticResource TileMenu}"
            Focusable="True"
            FocusVisualStyle="{x:Null}">
        <Border Padding="8" Style="{StaticResource CardBorder}">
          <StackPanel>
            <!-- A fixed 16:9 area, so a tile whose picture has not landed yet is the same size as one whose has
                 and nothing jumps when it does. -->
            <Grid ClipToBounds="True">
              <Viewbox Stretch="Uniform">
                <Grid Width="640" Height="360" Background="{StaticResource TileBrush}">
                  <Image RenderOptions.BitmapScalingMode="HighQuality"
                         Source="{Binding Thumbnail}"
                         Stretch="UniformToFill" />
                </Grid>
              </Viewbox>

              <!-- Drawn rather than typed: a glyph would depend on the font having one. -->
              <Border Margin="6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Style="{StaticResource StateTagBorder}"
                      ToolTip="In game"
                      Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}">
                <Path Data="M0,3.5 L3,6.5 L8.5,1"
                      Stretch="None"
                      Stroke="{StaticResource TextBrush}"
                      StrokeEndLineCap="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="1.6" />
              </Border>

              <!-- Revealed by the pointer, by keyboard focus, or by the tile's own menu being open, so both ways
                   of reaching a tile reach its actions (spec 7.8) and the button that opened the menu is still
                   drawn under it. Opacity rather than Visibility, the map panel's lesson: a collapsed button
                   cannot be tabbed to, so it would be mouse-only. Which of the three shows is the tile's own
                   answer: a picture with one map applies in a click, and a custom picture has to be asked where
                   to go. -->
              <StackPanel x:Name="Actions"
                          Margin="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Opacity="0"
                          Orientation="Horizontal">
                <!-- CanWrite, not IsNotBusy: this writes into the game folder, so it is also off while that
                     folder is missing (spec 7.8). -->
                <Button x:Name="Apply"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding ApplyText}"
                        IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource TileAction}" />
                <Button x:Name="ApplyTo"
                        AutomationProperties.Name="Apply to..."
                        Click="OnTileMenuButton"
                        Content="{Binding ApplyText}"
                        controls:Icon.Glyph="{StaticResource Icon.ChevronDown}"
                        Style="{StaticResource TileAction}"
                        Visibility="Collapsed" />
                <Button x:Name="Menu"
                        AutomationProperties.Name="More actions"
                        Click="OnTileMenuButton"
                        Style="{StaticResource TileAction}">
                  <controls:Icon Geometry="{StaticResource Icon.Dots}" Size="14" />
                </Button>
              </StackPanel>
            </Grid>

            <TextBlock Margin="2,8,2,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="2,2,2,0"
                       FontSize="11"
                       Foreground="{StaticResource Text2Brush}"
                       Text="{Binding Subtitle}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border x:Name="Ring"
                BorderBrush="{StaticResource TextBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius}"
                IsHitTestVisible="False"
                Opacity="0" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ShowChevron}" Value="True">
          <Setter TargetName="Apply" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Menu" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="ApplyTo" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </Trigger>

        <!-- An open menu takes the mouse, so the tile stops being hovered and the button that opened the menu
             would vanish while its own menu is still on screen. The menu is the tile's own instance, because
             TileMenu is x:Shared="False". -->
        <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=Tile}" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </DataTrigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <!-- Spec 4: title, search, zoom and Add Custom Image all on the header's one line. -->
    <controls:PageHeader DockPanel.Dock="Top" Title="Backgrounds">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <!-- Spec 4: the page's own search string, bound straight to the page view model. Centred at the
               action height, or the StackPanel stretches box and button to the taller of the two and the box
               reads as two lines. -->
          <Grid Width="200" Height="{StaticResource ActionHeight}" VerticalAlignment="Center">
            <!-- Its own padding, not the style's: a TextBox reserves the whole of Geist's line box, which at this
                 size is taller than an action, so the box keeps 6 at the top and 0 at the bottom to put its
                 glyphs on the buttons' own rows inside the header's 33 px. 6 is Task 4's measurement, not a typo:
                 the FieldTextBox template used to apply the padding twice, so the inset was written as 3 to halve
                 it. Do not put 3 back. The left padding is the canvas's: 10 to the icon, 15 of icon, 8 to the
                 text. -->
            <TextBox Padding="33,6,10,0"
                     AutomationProperties.Name="Search pictures"
                     Style="{StaticResource FieldTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Text3, the placeholder's own colour: nothing about a search box hovers or disables. -->
            <controls:Icon Margin="11,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Text3Brush}"
                           Geometry="{StaticResource Icon.Search}"
                           Size="15" />

            <!-- Hit test off, so the placeholder never swallows the click that focuses the box. Centred, so it sits
                 on the same rows the box draws its own text on and nothing shifts when typing starts. -->
            <TextBlock Margin="34,0,11,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search pictures">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <controls:ZoomSlider Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Maximum="{x:Static pages:BackgroundsViewModel.MaxZoom}"
                               Minimum="{x:Static pages:BackgroundsViewModel.MinZoom}"
                               Value="{Binding Zoom}" />

          <!-- Solid: adding a picture is this page's one primary action (spec 4). -->
          <Button Margin="12,0,0,0"
                  Command="{Binding AddPicturesCommand}"
                  Content="Add Custom Image"
                  controls:Icon.Glyph="{StaticResource Icon.Plus}"
                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!-- One column of sections rather than a grid with a bar under it: the ticked maps are reached through a
         tile's own menu now, so the page has nothing docked at its foot (spec 4). -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,8,0,0">
        <TextBlock Style="{StaticResource SectionHeaderText}"
                   Text="{Binding CustomHeader}"
                   Visibility="{Binding HasCustomPictures, Converter={StaticResource BoolToVis}}" />

        <!-- Not focusable, or Tab stops on the panel itself before it reaches the first tile. -->
        <ItemsControl Margin="0,8,0,0"
                      Focusable="False"
                      ItemContainerStyle="{StaticResource TileContainer}"
                      ItemTemplate="{StaticResource PictureTile}"
                      ItemsSource="{Binding CustomTiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Spec 4: no custom pictures says so, with the way in beside the line rather than under it. -->
        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasCustomPictures}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="No custom pictures yet." />
          <Button Margin="12,0,0,0"
                  Command="{Binding AddPicturesCommand}"
                  Content="Add Custom Image"
                  controls:Icon.Glyph="{StaticResource Icon.Plus}"
                  Style="{StaticResource OutlineButton}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

<UserControl x:Class="BhMaps.App.Views.Pages.BackgroundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:pages="clr-namespace:BhMaps.App.ViewModels.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- The two tile actions sit over the picture, so they carry the surface behind them rather than the outline
         button's transparent fill. Smaller than a page button, because at eight columns a tile is narrow. -->
    <Style x:Key="TileAction" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- The bottom selection bar (spec 7.3). It exists only while the sidebar has maps ticked. -->
    <Style x:Key="SelectionBar" TargetType="Border" BasedOn="{StaticResource CardBorder}">
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasSelection}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <!-- Spec 7.3: title, search, zoom and Add pictures all on the header's one line. -->
    <controls:PageHeader DockPanel.Dock="Top" Title="Backgrounds">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <!-- Spec 7.3: the page's own search string, bound straight to the page view model. Centred at the
               action height, or the StackPanel stretches box and button to the taller of the two and the box
               reads as two lines. -->
          <Grid Width="200" Height="{StaticResource ActionHeight}" VerticalAlignment="Center">
            <!-- Its own padding, not the style's: a TextBox reserves the whole of Geist's line box, which at this
                 size is taller than an action, and the style's 6 top and bottom would clip the text out of a box
                 this high. 6 and 0 leave the line box room and put the glyphs on the button's own rows. The left
                 padding is the canvas's: 10 to the icon, 15 of icon, 8 to the text. -->
            <TextBox Padding="33,6,10,0"
                     AutomationProperties.Name="Search backgrounds"
                     Style="{StaticResource FieldTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Text3, the placeholder's own colour: nothing about a search box hovers or disables. -->
            <controls:Icon Margin="11,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Text3Brush}"
                           Geometry="{StaticResource Icon.Search}"
                           Size="15" />

            <!-- Hit test off, so the placeholder never swallows the click that focuses the box. Centred, so it sits
                 on the same rows the box draws its own text on and nothing shifts when typing starts. -->
            <TextBlock Margin="34,0,11,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search backgrounds">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <controls:ZoomSlider Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Maximum="{x:Static pages:BackgroundsViewModel.MaxZoom}"
                               Minimum="{x:Static pages:BackgroundsViewModel.MinZoom}"
                               Value="{Binding Zoom}" />

          <!-- Outlined, as Settings' Capture defaults is: the page's one solid button belongs to the empty state,
               which is the only place the action is the whole answer (spec 7.1). -->
          <Button Margin="12,0,0,0"
                  Command="{Binding AddPicturesCommand}"
                  Content="Add pictures"
                  controls:Icon.Glyph="{StaticResource Icon.Plus}"
                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource OutlineButton}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!-- Rows rather than a docked bar, so declaration order is visual order and Tab reaches the grid before the
         bar under it (the sidebar's lesson from Task 23). -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <!-- Not focusable, or Tab stops on the panel itself before it reaches the first tile. Top aligned, or a
               UniformGrid handed the whole viewport stretches its rows and a handful of tiles come out enormous. -->
          <ItemsControl VerticalAlignment="Top" Focusable="False" ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemContainerStyle>
              <!-- Without it the container a tile sits in announces the view model's type name. -->
              <Style TargetType="ContentPresenter">
                <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- The tile itself takes focus, so the ring is visible on it as well as on its two actions
                     (spec 7.8). It has no action of its own, so it is not a button. -->
                <Grid x:Name="Tile"
                      Margin="0,0,12,12"
                      AutomationProperties.Name="{Binding FileName}"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}">
                  <Border Padding="8" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <!-- A fixed 16:9 area, so a tile whose picture has not landed yet is the same size as one
                           whose has and nothing jumps when it does. -->
                      <Grid ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                          <Grid Width="640" Height="360" Background="{StaticResource TileBrush}">
                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Thumbnail}"
                                   Stretch="UniformToFill" />
                          </Grid>
                        </Viewbox>

                        <!-- Drawn rather than typed: a glyph would depend on the font having one. -->
                        <Border Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource StateTagBorder}"
                                ToolTip="In use by a selected map"
                                Visibility="{Binding IsInUse, Converter={StaticResource BoolToVis}}">
                          <Path Data="M0,3.5 L3,6.5 L8.5,1"
                                Stretch="None"
                                Stroke="{StaticResource TextBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </Border>

                        <!-- Revealed by the pointer or by keyboard focus, so both ways of reaching a tile reach
                             its actions (spec 7.8). -->
                        <StackPanel x:Name="Actions"
                                    Margin="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                          <!-- CanWrite, not IsNotBusy: this writes into the game folder, so it is also off while
                               that folder is missing (spec 7.8). Edit beside it is library-only and is not.
                               No icons on these two, though the canvas draws them: the canvas puts these actions
                               under a tile in a four column grid, while here they sit over a tile that is 94 px
                               wide inside at eight columns. An icon each takes the pair from 88 px to 132 and the
                               clip cuts Apply in half (measured at 1280 wide, zoom 8). -->
                          <Button Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"
                                  Content="Apply"
                                  IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource TileAction}" />
                          <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"
                                  Content="Edit"
                                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource TileAction}" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Margin="2,8,2,0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="2,2,2,0"
                                 FontSize="11"
                                 Foreground="{StaticResource Text2Brush}"
                                 Text="{Binding PackName}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>

                  <Border x:Name="Ring"
                          BorderBrush="{StaticResource TextBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource Radius}"
                          IsHitTestVisible="False"
                          Opacity="0" />
                </Grid>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Spec 7.8: an empty library says so and offers the way in. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLibraryEmpty}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="No backgrounds yet." />
          <Button Margin="0,12,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding AddPicturesCommand}"
                  Content="Add pictures"
                  controls:Icon.Glyph="{StaticResource Icon.Plus}"
                  Style="{StaticResource PrimaryButton}" />
        </StackPanel>

        <!-- Spec 7.8 again: a search that matches nothing is a different state from an empty library. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsLibraryEmpty}" Value="False" />
                    <Condition Binding="{Binding Tiles.Count}" Value="0" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock HorizontalAlignment="Center"
                     Foreground="{StaticResource Text2Brush}"
                     Text="No backgrounds match this search." />
          <Button Margin="0,8,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding ClearSearchCommand}"
                  Content="Clear search"
                  Style="{StaticResource PlainButton}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource SelectionBar}">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  Content="Clear"
                  Style="{StaticResource PlainButton}" />
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="{Binding SelectionText}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>

<UserControl x:Class="BhMaps.App.Views.Pages.PackDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:pages="clr-namespace:BhMaps.App.ViewModels.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- What a section says when it holds nothing. Collapsed by default; each one carries its own trigger. -->
    <Style x:Key="SectionNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Without these a screen reader reads the view model's type name off every generated container, as Tasks 23
         and 28 found in the automation tree. -->
    <Style x:Key="MapTileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
    </Style>

    <Style x:Key="BackgroundTileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    </Style>

    <!-- One tile: the picture is an ImageBrush so it keeps the radius, and the Tile colour behind it is what a
         preview that has not arrived yet, or could not be drawn at all, shows. Nothing here is interactive, so
         there is no focus ring to draw: the page's tab stops are its buttons. -->
    <DataTemplate x:Key="MapTile">
      <StackPanel Width="{x:Static pages:PackDetailViewModel.TileWidth}" Margin="0,0,12,12">
        <Border Width="{x:Static pages:PackDetailViewModel.TileWidth}"
                Height="{x:Static pages:PackDetailViewModel.TileHeight}"
                Background="{StaticResource TileBrush}"
                CornerRadius="{StaticResource Radius}">
          <Border CornerRadius="{StaticResource Radius}">
            <Border.Background>
              <ImageBrush ImageSource="{Binding Preview}" Stretch="Uniform" />
            </Border.Background>
          </Border>
        </Border>
        <TextBlock Margin="2,8,2,0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- The same tile for one of the pack's own background images, captioned with the file name, which is the
         slot it fills. -->
    <DataTemplate x:Key="BackgroundTile">
      <StackPanel Width="{x:Static pages:PackDetailViewModel.TileWidth}" Margin="0,0,12,12">
        <Border Width="{x:Static pages:PackDetailViewModel.TileWidth}"
                Height="{x:Static pages:PackDetailViewModel.TileHeight}"
                Background="{StaticResource TileBrush}"
                CornerRadius="{StaticResource Radius}">
          <Border CornerRadius="{StaticResource Radius}">
            <Border.Background>
              <ImageBrush ImageSource="{Binding Preview}" Stretch="Uniform" />
            </Border.Background>
          </Border>
        </Border>
        <TextBlock Margin="2,8,2,0"
                   Style="{StaticResource MonoText}"
                   Text="{Binding Name}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <!-- The only page whose title is not a fixed word: it is the pack the shell navigated to. -->
    <controls:PageHeader DockPanel.Dock="Top" Title="{Binding Title}">
      <controls:PageHeader.Actions>
        <!-- Disabled while the shell is busy, the same hop past the page to the window's MainViewModel the header
             itself makes (decision D11), so a second operation cannot be started from a live-looking button. -->
        <StackPanel IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}" Orientation="Horizontal">
          <!-- CanWrite on top of the panel's IsNotBusy: applying a pack writes into the game folder, so it is
               also off while that folder is missing (spec 7.8). The two beside it only read the library. -->
          <Button Command="{Binding ApplyAllCommand}"
                  Content="Apply all"
                  IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource PrimaryButton}" />
          <Button Margin="8,0,0,0"
                  Command="{Binding OpenFolderCommand}"
                  Content="Open folder"
                  Style="{StaticResource OutlineButton}" />
          <Button Margin="8,0,0,0"
                  Command="{Binding BackToPacksCommand}"
                  Content="Back to packs"
                  Style="{StaticResource PlainButton}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}">
      <!-- One scroller over all four sections: the page shows every row and nothing is truncated
           (spec section 2, Packs). -->
      <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource SectionHeaderText}" Text="Put together" />
          <TextBlock Text="{Binding MapsEmptyText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SectionNote}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PutTogether.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl Margin="0,10,0,0"
                        Focusable="False"
                        ItemContainerStyle="{StaticResource MapTileContainer}"
                        ItemTemplate="{StaticResource MapTile}"
                        ItemsSource="{Binding PutTogether}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <TextBlock Margin="0,12,0,0" Style="{StaticResource SectionHeaderText}" Text="Backgrounds" />
          <TextBlock Text="{Binding BackgroundsEmptyText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SectionNote}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Backgrounds.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl Margin="0,10,0,0"
                        Focusable="False"
                        ItemContainerStyle="{StaticResource BackgroundTileContainer}"
                        ItemTemplate="{StaticResource BackgroundTile}"
                        ItemsSource="{Binding Backgrounds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <TextBlock Margin="0,12,0,0" Style="{StaticResource SectionHeaderText}" Text="Platforms" />
          <TextBlock Text="{Binding MapsEmptyText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SectionNote}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Platforms.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl Margin="0,10,0,0"
                        Focusable="False"
                        ItemContainerStyle="{StaticResource MapTileContainer}"
                        ItemTemplate="{StaticResource MapTile}"
                        ItemsSource="{Binding Platforms}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- A6 and spec 7.5: only shown when the pack has files that change nothing in game, and removing them
               is an offer, never automatic. -->
          <Border Margin="0,8,0,0"
                  Padding="14,10"
                  Style="{StaticResource CardBorder}"
                  Visibility="{Binding HasTransparent, Converter={StaticResource BoolToVis}}">
            <Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding TransparentText}" />
              <Button HorizontalAlignment="Right"
                      Command="{Binding RemoveTransparentCommand}"
                      Content="Remove"
                      Style="{StaticResource OutlineButton}" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Only reachable by navigating here before a pack was picked, which nothing in the shell does; it is here
           so the page never shows three empty sections and no explanation. -->
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource Text2Brush}"
                 Text="{Binding EmptyText}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasPack}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</UserControl>

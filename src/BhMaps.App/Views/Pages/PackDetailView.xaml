<UserControl x:Class="BhMaps.App.Views.Pages.PackDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BhMaps.App.Behaviors"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:converters="clr-namespace:BhMaps.App.Converters"
             xmlns:imaging="clr-namespace:BhMaps.Core.Imaging;assembly=BhMaps.Core"
             xmlns:pages="clr-namespace:BhMaps.App.ViewModels.Pages"
             behaviors:SizeShortcuts.Target="{Binding}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />
    <converters:PackTileSelectionConverter x:Key="TileSelection" />

    <!-- 3.7.2: the chips and the size switch in the header draw no fill of their own, so the backdrop shows
         through them; the border, the checked fill and the hover stay. -->
    <SolidColorBrush x:Key="ChipFillBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SizePickerFillBrush" Color="Transparent" />
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyTileCommand}" />
    <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutTileCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
  </UserControl.InputBindings>

  <!-- 3.7.3: image files dropped anywhere on a pack the app writes to open Add pictures with them listed. -->
  <Grid AllowDrop="True" Background="Transparent" DragOver="Page_DragOver" Drop="Page_Drop">
    <!-- 3.0: the backdrop. The pack's first card, blown up and faded into the page, so the page opens with the
         pack's own art rather than a title on empty background. Since 3.7.2 it is the whole page, edge to edge
         and down to the bottom, behind the header and the cards, and it stays put while the cards scroll over
         it. A pack with no cards draws the page colour alone. -->
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <!-- 3.7.2: the picture is blurred, so at full page size it reads as the pack's colours rather than as a
           stretched card whose platforms turn into big dark shapes. The negative margin pushes the blur's soft
           edge outside the clip, so the window edges stay as bright as the middle. -->
      <Border Margin="-80" RenderOptions.BitmapScalingMode="HighQuality">
        <Border.Background>
          <ImageBrush ImageSource="{Binding BackdropTile.Preview}" Opacity="0.35" Stretch="UniformToFill" />
        </Border.Background>
        <Border.Effect>
          <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
        </Border.Effect>
      </Border>

      <!-- 3.1 C11: a flat wash of the page's own colour over the picture, under the gradient, so the title and
           the subtitle read against it whatever the pack's first card happens to be. -->
      <Border Background="{StaticResource BgBrush}" Opacity="0.55" />

      <Border>
        <Border.Background>
            <!-- The page's own colour drawn back over the picture, thickening downwards on an eased curve, so the
                 top is the strongest and the picture is still faintly there at the bottom: it never goes fully
                 opaque. The stops are BgBrush's colour at rising alpha, which is why they are literals and add
                 no palette entry. -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#00161514" />
              <GradientStop Offset="0.15" Color="#12161514" />
              <GradientStop Offset="0.35" Color="#3A161514" />
              <GradientStop Offset="0.55" Color="#6A161514" />
              <GradientStop Offset="0.75" Color="#98161514" />
              <GradientStop Offset="1" Color="#C0161514" />
            </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- 3.7.2: the picture eases in under the top bar's hairline instead of starting at full strength right
           against it. The top stop is the top bar's own colour (BgBrush), so the bar and the page meet on the
           same colour and the picture comes up over the first 96 px. -->
      <Border Height="96" VerticalAlignment="Top">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF161514" />
            <GradientStop Offset="0.2" Color="#D6161514" />
            <GradientStop Offset="0.45" Color="#8A161514" />
            <GradientStop Offset="0.7" Color="#3A161514" />
            <GradientStop Offset="1" Color="#00161514" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

  <DockPanel Margin="24,8,24,24">
      <StackPanel DockPanel.Dock="Top" Margin="0,12,0,16" VerticalAlignment="Top">
        <controls:PageHeader x:Name="Header" Title="{Binding Title}">
      <controls:PageHeader.Leading>
        <Button AutomationProperties.Name="Back" Command="{Binding BackToPacksCommand}"
                controls:Icon.Glyph="{StaticResource Icon.ChevronLeft}" Style="{StaticResource PlainButton}"
                ToolTip="Back to packs" />
      </controls:PageHeader.Leading>
      <controls:PageHeader.Actions>
        <StackPanel IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                    Orientation="Horizontal">
          <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource Text3Brush}"
                     Text="{Binding ClipboardHint}"
                     Visibility="{Binding HasClipboardHint, Converter={StaticResource BoolToVis}}" />
          <!-- 3.2 P1: Both / Platforms / Backgrounds, the one remembered switch Packs, a pack's page and Maps share.
               A ListBox like the Maps chips, so the arrow keys move inside it and Tab lands on the selected chip. -->
          <ListBox Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Show"
                   ItemContainerStyle="{StaticResource ChipRow}"
                   ItemsSource="{Binding PreviewModeChips}"
                   SelectedItem="{Binding PreviewModeChip}"
                   Style="{StaticResource TileListBox}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <controls:SizePicker Margin="0,0,12,0" VerticalAlignment="Center" Value="{Binding TileSize}" />
          <Button Margin="0,0,8,0" Command="{Binding ImportFromPackCommand}" Content="Import from pack"
                  controls:Icon.Glyph="{StaticResource Icon.FolderPlus}"
                  FocusVisualStyle="{StaticResource DialogFocusRing}"
                  Style="{StaticResource OutlineButton}"
                  ToolTip="{x:Static pages:PackDetailViewModel.NoOtherPackText}"
                  ToolTipService.ShowOnDisabled="True" />
          <Button Margin="0,0,8,0" Command="{Binding OpenFolderCommand}" Content="Open folder"
                  controls:Icon.Glyph="{StaticResource Icon.FolderOpen}" Style="{StaticResource OutlineButton}" />

          <!-- Last, because the page's one primary ends the row (3.0). -->
          <Button Command="{Binding ApplyAllCommand}" Content="Apply all"
                  controls:Icon.Glyph="{StaticResource Icon.Download}"
                  IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Indented to the title, which the back chevron pushes across by its own padded width. 3.9: the
             indent was a fixed 46 px, but the chevron button measures wider than that (14 px padding each side
             plus the icon slot's 7 px right margin, which an icon-only button still carries), so the line started
             about 9 px left of the title. The spacer now takes the button's real width plus the header's 4 px. -->
        <DockPanel Margin="0,-5,0,0">
          <Border Width="{Binding Leading.ActualWidth, ElementName=Header}" Margin="0,0,4,0" DockPanel.Dock="Left" />
          <TextBlock FontSize="{StaticResource FontBody}"
                     Foreground="{StaticResource TextBrush}"
                     Text="{Binding Subtitle}"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </StackPanel>

    <!-- The body and the no-pack note share one cell, as they did before the rewrite: the DockPanel fills with
         this Grid, and only one of the two is ever visible. -->
    <Grid>
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.GameFolderMissing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
              Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <DockPanel>
            <Border DockPanel.Dock="Top" Margin="0,4,0,12" Padding="14,10" Style="{StaticResource CardBorder}"
                    Visibility="{Binding HasTransparent, Converter={StaticResource BoolToVis}}">
              <Grid>
                <TextBlock VerticalAlignment="Center" Text="{Binding TransparentText}" />

                <!-- 3.1 C8: Remove, then the way to put the note away without touching the files. It comes back
                     on its own once the pack holds a different number of them. -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <Button Command="{Binding RemoveTransparentCommand}" Content="Remove"
                          controls:Icon.Glyph="{StaticResource Icon.Trash}" Style="{StaticResource OutlineButton}" />
                  <Button Margin="4,0,0,0" AutomationProperties.Name="Dismiss the note"
                          Command="{Binding DismissTransparentCommand}"
                          controls:Icon.Glyph="{StaticResource Icon.X}" Style="{StaticResource PlainButton}"
                          ToolTip="Dismiss" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid>
              <!-- 3.7.3: ItemsSource is set in the code-behind, the cards plus the Add image card after them. -->
              <ListBox x:Name="Tiles" SelectedItem="{Binding SelectedTile, Converter={StaticResource TileSelection}}"
                       SelectionMode="Single" Style="{StaticResource TileListBox}"
                       PreviewKeyDown="Tiles_PreviewKeyDown"
                       SelectionChanged="Tiles_SelectionChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Resources>
                  <!-- The ScrollViewer is inside the ListBox's own template, so the behaviour reaches it through an
                       implicit style rather than as an attribute (spec 10). -->
                  <Style TargetType="ScrollViewer">
                    <Setter Property="behaviors:SmoothScroll.IsEnabled" Value="True" />
                  </Style>
                  <DataTemplate DataType="{x:Type pages:PackTileViewModel}">
                    <!-- Background="Transparent" so a right click on the gap between the picture and the caption
                         reaches the menu, which the Border carries for the whole tile (spec 4.1). -->
                    <Border x:Name="Tile"
                            Background="Transparent"
                            ContextMenu="{StaticResource TileMenu}"
                            ContextMenuOpening="OnTileMenuOpening"
                            Focusable="True"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="{Binding Caption}">
                      <StackPanel>
                        <Grid>
                          <!-- 3.9.1: the Viewbox sets the size and draws nothing; the picture is a rounded Border's
                               ImageBrush, so its corners stay inside the rounded hairline. -->
                          <Viewbox Stretch="Uniform">
                            <Grid Width="{Binding Source={x:Static imaging:MapCompositor.CardWidth}, Mode=OneTime}"
                                  Height="{Binding Source={x:Static imaging:MapCompositor.CardHeight}, Mode=OneTime}" />
                          </Viewbox>
                          <Border Background="{StaticResource TileBrush}" CornerRadius="{StaticResource Radius}" />
                          <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                              <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                          <!-- Prototype: the picture's hairline, Line to Line2 on hover. -->
                          <Border BorderThickness="1" CornerRadius="{StaticResource Radius}" IsHitTestVisible="False">
                            <Border.BorderBrush>
                              <SolidColorBrush x:Name="EdgeBrush" Color="{StaticResource LineColor}" />
                            </Border.BorderBrush>
                          </Border>
                          <Button x:Name="MenuButton"
                                  Margin="0,6,6,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  AutomationProperties.Name="More actions"
                                  Click="OnTileMenuButton"
                                  Opacity="0"
                                  Style="{StaticResource TileAction}">
                            <controls:Icon Geometry="{StaticResource Icon.Dots}" Size="14" />
                          </Button>
                        </Grid>
                        <!-- 3.0: no name at Small, exactly as the Maps grid does it. The tooltip still has it. -->
                        <TextBlock Margin="2,8,2,0" Text="{Binding Caption}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFileTile}" Value="True">
                                  <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                                  <Setter Property="FontSize" Value="12" />
                                  <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                        <Setter TargetName="MenuButton" Property="Opacity" Value="1" />
                        <Trigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <ColorAnimation Storyboard.TargetName="EdgeBrush" Storyboard.TargetProperty="Color" To="{StaticResource Line2Color}" Duration="{StaticResource FadeDuration}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <ColorAnimation Storyboard.TargetName="EdgeBrush" Storyboard.TargetProperty="Color" Duration="{StaticResource FadeDuration}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                      <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="MenuButton" Property="Opacity" Value="1" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                  <!-- 3.7.3: the last item of the grid, a card-sized outline that opens Add pictures. The invisible
                       Viewbox gives it a card's shape at whatever width the panel hands it; the blank caption line
                       keeps it as tall as a named card. The button takes no focus: the keyboard lands on the item,
                       and Enter or Space there runs the same command (the code-behind). -->
                  <DataTemplate DataType="{x:Type pages:AddImageTile}">
                    <StackPanel>
                      <Button AutomationProperties.Name="Add image"
                              Command="{Binding DataContext.AddImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              Cursor="Hand"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}"
                              Foreground="{StaticResource Text2Brush}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Grid>
                              <Viewbox Stretch="Uniform">
                                <Rectangle Width="{Binding Source={x:Static imaging:MapCompositor.CardWidth}, Mode=OneTime}"
                                           Height="{Binding Source={x:Static imaging:MapCompositor.CardHeight}, Mode=OneTime}" />
                              </Viewbox>
                              <!-- Prototype: template brushes, so hover fades the fill and the hairline. -->
                              <Border x:Name="Box" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                                <Border.Background>
                                  <SolidColorBrush x:Name="BoxFill" Color="#00242220" />
                                </Border.Background>
                                <Border.BorderBrush>
                                  <SolidColorBrush x:Name="BoxEdge" Color="{StaticResource LineColor}" />
                                </Border.BorderBrush>
                              </Border>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:Icon HorizontalAlignment="Center" Geometry="{StaticResource Icon.Plus}" Size="20" />
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="Add image" />
                              </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <ColorAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Color" To="{StaticResource Surface2Color}" Duration="{StaticResource FadeDuration}" />
                                      <ColorAnimation Storyboard.TargetName="BoxEdge" Storyboard.TargetProperty="Color" To="{StaticResource Line2Color}" Duration="{StaticResource FadeDuration}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <ColorAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Color" Duration="{StaticResource FadeDuration}" />
                                      <ColorAnimation Storyboard.TargetName="BoxEdge" Storyboard.TargetProperty="Color" Duration="{StaticResource FadeDuration}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                      <TextBlock Margin="2,8,2,0" Text=" "
                                 Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                  <!-- The theme's ring, plus one click to open: a plain click selects and opens the drawer, and the
                       keyboard opens with Enter, which the code-behind handles (spec 5). -->
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource HoverTileListBoxItem}">
                    <!-- Prototype: the edge is on the picture inside the tile, not round picture and caption. -->
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
                    <!-- 3.0: no margin here, because the justified panel owns the gutter. -->
                    <Setter Property="Margin" Value="0" />
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Tile_Click" />
                    <EventSetter Event="MouseEnter" Handler="Tile_MouseEnter" />
                    <EventSetter Event="MouseLeave" Handler="Tile_MouseLeave" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- 3.0: the same justified grid the Maps page has. The size is a target width; the panel fits
                         as many tiles across as it can and shares the rest of the row out over them, so the grid
                         reaches the edge whatever the drawer is doing. -->
                    <controls:JustifiedPanel VerticalAlignment="Top"
                                             Gap="12"
                                             TargetWidth="{Binding DataContext.TargetCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>

              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"
                         Text="{Binding EmptyNote}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Items.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>

          <!-- The automation name binds DisplayName, not Drawer.DisplayName: this Border reassigns its own
               DataContext to the drawer on the line below, so a Drawer. prefix here would resolve against
               PackDrawerViewModel, find nothing, and leave the panel nameless with no diagnostic. -->
          <Border Grid.Column="1" Width="{StaticResource PanelWidth}" Margin="16,0,0,0"
  AutomationProperties.Name="{Binding DisplayName}" behaviors:Fold.Animate="True"
                  DataContext="{Binding Drawer}"
                  Style="{StaticResource CardBorder}"
                  Visibility="{Binding DataContext.Drawer, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="16,12,8,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="{StaticResource FontEmphasis}" FontWeight="SemiBold" Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource Text3Brush}"
                             Text="{Binding SetsText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" AutomationProperties.Name="Close"
                        Command="{Binding CloseCommand}" Foreground="{StaticResource Text2Brush}" Padding="8"
                        Style="{StaticResource PlainButton}" ToolTip="Close">
                  <controls:Icon Geometry="{StaticResource Icon.X}" Size="16" />
                </Button>
              </Grid>

              <ScrollViewer Grid.Row="1" Margin="16,4,4,0" HorizontalScrollBarVisibility="Disabled"
                            behaviors:SmoothScroll.IsEnabled="True"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,16">
                  <Viewbox Stretch="Uniform">
                    <Grid Width="{Binding Source={x:Static imaging:MapCompositor.CardWidth}, Mode=OneTime}"
                          Height="{Binding Source={x:Static imaging:MapCompositor.CardHeight}, Mode=OneTime}"
                          Background="{StaticResource TileBrush}">
                      <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Preview.Preview}"
                             Stretch="UniformToFill" />
                    </Grid>
                  </Viewbox>
                  <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Text2Brush}" Text="{Binding InGameText}"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,16,0,6" Style="{StaticResource SectionHeaderText}" Text="Files in this pack" />
                  <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Style="{StaticResource MonoText}" Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Mono}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource Text3Brush}" Text="{Binding SizeText}" />
                            <TextBlock Margin="8,0,0,0" FontFamily="{StaticResource Mono}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource Text3Brush}"
                                       Text="{Binding Dimensions}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <StackPanel Grid.Row="2" Margin="16,8,16,14" Orientation="Horizontal">
                <Button Command="{Binding ApplyToThisMapCommand}" Content="Apply to this map"
                        controls:Icon.Glyph="{StaticResource Icon.Download}"
                        IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" Content="Open folder"
                        controls:Icon.Glyph="{StaticResource Icon.FolderOpen}" Style="{StaticResource PlainButton}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Only reachable by navigating here before a pack was picked, which nothing in the shell does; it is here
             so the page never shows an empty grid and no explanation. -->
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Text2Brush}"
                   Text="{Binding EmptyText}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasPack}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <!-- 3.0: with no game folder there is nothing on this page to read or write, so the page itself says so
           and offers the one thing that fixes it. The picker, the save and the rescan behind it are the Settings
           page's own command; there is one of them. -->
      <controls:EmptyState ActionCommand="{Binding DataContext.SettingsPage.ChangeGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           ActionText="Choose folder"
                           Text="Game folder not found. Choose the Brawlhalla mapArt folder to continue."
                           Visibility="{Binding DataContext.GameFolderMissing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DockPanel>
  </Grid>
</UserControl>

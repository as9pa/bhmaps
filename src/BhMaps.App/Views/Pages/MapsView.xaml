<UserControl x:Class="BhMaps.App.Views.Pages.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:converters="clr-namespace:BhMaps.App.Converters"
             xmlns:imaging="clr-namespace:BhMaps.Core.Imaging;assembly=BhMaps.Core"
             xmlns:pages="clr-namespace:BhMaps.App.ViewModels.Pages"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             PreviewKeyDown="OnPageKeyDown">
  <!-- Spec 3.2: Escape closes the panel first, and a second Escape clears the ticks. Escape in the search box is
       the typed text's first; OnPageKeyDown handles that one before this binding can see it. -->
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />

    <!-- Owner change O5: Ctrl+A ticks every shown map from anywhere on the page. A KeyBinding here catches the
         ones the focused control did not want: the grid's own Ctrl+A and the search box's both run first and mark
         the key handled, so neither loses its meaning. -->
    <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllShownCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />
    <converters:WidthAtLeastConverter x:Key="WidthAtLeast" />

    <!-- A chip is a ListBoxItem so the list owns which one is on, and the theme's ChipToggle draws it. The toggle
         is chrome only: hit testing and focus belong to the row, which is what Tab and the arrow keys walk. -->
    <Style x:Key="ChipRow" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,0" />

      <!-- Owner change O2: the hand the top bar's tabs show. It belongs on the row rather than on ChipToggle,
           which carries one already but is IsHitTestVisible=False, so the cursor under the pointer is the row's. -->
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <!-- Transparent, not unset: a Grid with no Background is not hit-testable, and both children below
                 are IsHitTestVisible=False, so without this the ListBoxItem never sees a mouse click and only UI
                 Automation, which bypasses hit testing, could select a chip (spec 9). -->
            <Grid Background="Transparent">
              <primitives:ToggleButton x:Name="Chip"
                                       Content="{TemplateBinding Content}"
                                       Focusable="False"
                                       IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                                       IsHitTestVisible="False"
                                       Style="{StaticResource ChipToggle}" />

              <!-- Keyboard focus is visible on every chip (spec 7.8), drawn at the same 60% as the tiles. -->
              <Border x:Name="Ring"
                      BorderBrush="{StaticResource TextBrush}"
                      BorderThickness="1"
                      CornerRadius="14"
                      IsHitTestVisible="False"
                      Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The card is a ListBoxItem, so Ctrl and Shift clicks, Space, the arrow keys and Ctrl+A are the control's
         (spec 3.1). A plain click is the page's: it opens the panel and leaves the ticks alone. The gap is the
         zoom's (spec 3.1), read off the page rather than set here, so the two tightest steps can tighten it. -->
    <Style x:Key="MapCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileListBoxItem}">
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="Margin" Value="{Binding DataContext.CardMargin, RelativeSource={RelativeSource AncestorType=ListBox}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnCardMouseDown" />
      <EventSetter Event="PreviewKeyDown" Handler="OnCardKeyDown" />
    </Style>

    <!-- Spec 3.3: the bar floats over the cards, so while it is up the grid hands that room back at the bottom
         and the last row scrolls clear of it instead of sitting underneath it. Bottom only, so nothing above
         moves when the first map is ticked. 67 px is the bar's own height (an action's 33, the style's 8 of
         padding top and bottom, the card border's 1 each side) plus the 16 px it floats off the bottom. -->
    <Style x:Key="MapGrid" TargetType="ListBox" BasedOn="{StaticResource TileListBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasTicks}" Value="True">
          <Setter Property="Padding" Value="0,0,0,67" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Owner change O6: the card's state tag, written once here because the card draws it in one of two
         places (the name's row, or the picture's corner).
         Two tags, because Missing is a style of its own rather than a colour on the ordinary one. Each sits in
         a wrapper that carries the visibility, so neither theme style is derived from, and a card with no tag
         asks for no room at all.
         MaxWidth is what makes the trimming below fire: an Auto column hands a pill whatever it asks for, so
         without a ceiling a long pack name would take the name's room and still run off the card. 106 px is the
         measured 97 px of a 16 character tag in the theme's 11 px font, padding included, with room for wider
         glyphs at that length; a picture's name is ellipsised at 16 characters already, so this is where a pack
         name meets the same edge. -->
    <DataTemplate x:Key="CardTagPill">
      <Grid MaxWidth="106">
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowTag}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{StaticResource StateTagBorder}">
            <TextBlock Text="{Binding TagText}" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{StaticResource MissingTagBorder}">
            <TextBlock Text="{Binding TagText}" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>

    <!-- The same pill where it is drawn over the picture: map art is any colour, so the pill is given a ground
         there, and only there, which leaves the name row's pill on the two theme backgrounds it has always had.
         Collapsed on a card with no tag, or the ground would draw as a small empty square in the corner. -->
    <DataTemplate x:Key="CardTagPillOnPicture">
      <Border Background="{StaticResource ScrimBrush}" CornerRadius="6" Padding="2">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowTag}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardTagPill}" />
      </Border>
    </DataTemplate>

    <!-- Everything clickable in the panel that is a picture rather than a label: no chrome of its own, the tiles'
         60% focus ring, and the same Surface2 hover the cards use. -->
    <Style x:Key="PanelTileButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{StaticResource Radius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <Border x:Name="Ring"
                      BorderBrush="{StaticResource TextBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius}"
                      IsHitTestVisible="False"
                      Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The panel's Close: the canvas's cross as a geometry rather than a glyph font or an emoji, named for the
         automation tree. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PanelTileButton}">
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Radius 6 everywhere, so the picture is an ImageBrush on a Border rather than an Image with square corners.
         The tile colour behind it is what an empty slot shows. -->
    <Style x:Key="PictureTile" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource TileBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    </Style>

    <Style x:Key="TileCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="QuietNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <!-- The file list's header. The canvas's two chevrons rather than one rotated, which needs no transform
         origin, and they lead the label the way it draws them. Foreground on the style, so the icon inherits the
         colour the label states for itself: the implicit TextBlock style would beat inheritance on the text. -->
    <Style x:Key="FilesToggle" TargetType="primitives:ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="primitives:ToggleButton">
            <Grid>
              <Border x:Name="Chrome"
                      Background="Transparent"
                      CornerRadius="{StaticResource Radius}"
                      Padding="8,6">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon x:Name="Chevron"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Geometry="{StaticResource Icon.ChevronRight}"
                                 Size="14" />
                  <TextBlock Foreground="{StaticResource Text2Brush}"
                             Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
              </Border>
              <Border x:Name="Ring"
                      BorderBrush="{StaticResource TextBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius}"
                      IsHitTestVisible="False"
                      Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chevron" Property="Geometry" Value="{StaticResource Icon.ChevronDown}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Without these the container a generated item sits in announces the view model's type name. On the container
         and not on the tile: a Border has no automation peer of its own, so a name set there reaches nothing. -->
    <Style x:Key="PanelTileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    </Style>

    <Style x:Key="PanelSetContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding PackName}" />
    </Style>

    <!-- One background on offer for this map. The whole tile carries the menu, so a right click anywhere on it and
         the menu button open the same five lines, and Shift+F10 finds it through TileMenus. -->
    <DataTemplate x:Key="PanelPictureTile">
      <Border x:Name="Tile"
              ContextMenu="{StaticResource TileMenu}"
              Focusable="True"
              FocusVisualStyle="{x:Null}"
              Style="{StaticResource PanelTile}">
        <StackPanel>
          <Grid>
            <Border Height="80" Style="{StaticResource PictureTile}">
              <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Border>

            <Border x:Name="InGameTick"
                    Margin="0,4,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgBrush}"
                    CornerRadius="4"
                    Padding="4,3"
                    Visibility="Collapsed">
              <Path Data="M0,3.4 L2.8,6.2 L8,0.6"
                    Stroke="{StaticResource TextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Border>

            <!-- CanWrite, not IsNotBusy: an apply writes into the game folder, so it is also off while that folder
                 is missing (spec 7.8). Revealed by opacity rather than Visibility: a collapsed button cannot be
                 tabbed to, so it would be mouse-only. -->
            <StackPanel x:Name="Actions"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Opacity="0">
              <Button AutomationProperties.Name="{Binding ApplyText}"
                      Command="{Binding ApplyCommand}"
                      Content="{Binding ApplyText}"
                      IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                      Style="{StaticResource TileAction}" />
              <Button Margin="4,0,0,0"
                      AutomationProperties.Name="More actions"
                      Click="OnTileMenuButton"
                      Style="{StaticResource TileAction}">
                <controls:Icon Geometry="{StaticResource Icon.Dots}" Size="14" />
              </Button>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,6,0,0" Style="{StaticResource TileCaption}" Text="{Binding Title}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsInGame}" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource TextBrush}" />
          <Setter TargetName="InGameTick" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource Surface2Brush}" />
        </Trigger>

        <!-- An open menu takes the mouse, so the tile stops being hovered and the button that opened the menu
             would vanish while its own menu is still on screen. The menu is the tile's own instance, because
             TileMenu is x:Shared="False". -->
        <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=Tile}" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One platform set on offer for this map. The same tile as a picture's, over the map's current background,
         and the pack's name under it. Its menu is the set's three lines rather than a picture's five. -->
    <DataTemplate x:Key="PanelSetTile">
      <Border x:Name="Tile"
              ContextMenu="{StaticResource TileMenu}"
              Focusable="True"
              FocusVisualStyle="{x:Null}"
              Style="{StaticResource PanelTile}">
        <StackPanel>
          <Grid>
            <Border Height="88" Style="{StaticResource PictureTile}">
              <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Border>

            <Border x:Name="InGameTick"
                    Margin="0,4,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgBrush}"
                    CornerRadius="4"
                    Padding="4,3"
                    Visibility="Collapsed">
              <Path Data="M0,3.4 L2.8,6.2 L8,0.6"
                    Stroke="{StaticResource TextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Border>

            <StackPanel x:Name="Actions"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Opacity="0">
              <Button AutomationProperties.Name="Apply"
                      Command="{Binding ApplyToMapCommand}"
                      Content="Apply"
                      IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                      Style="{StaticResource TileAction}" />
              <Button Margin="4,0,0,0"
                      AutomationProperties.Name="More actions"
                      Click="OnTileMenuButton"
                      Style="{StaticResource TileAction}">
                <controls:Icon Geometry="{StaticResource Icon.Dots}" Size="14" />
              </Button>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,6,0,0" Style="{StaticResource TileCaption}" Text="{Binding PackName}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding InGame}" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource TextBrush}" />
          <Setter TargetName="InGameTick" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource Surface2Brush}" />
        </Trigger>

        <!-- An open menu takes the mouse, so the tile stops being hovered and the button that opened the menu
             would vanish while its own menu is still on screen. The menu is the tile's own instance, because
             TileMenu is x:Shared="False". -->
        <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=Tile}" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One platform file: its thumbnail, its name, and where the game's copy came from. -->
    <DataTemplate x:Key="PlatformFile">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="48"
                Height="27"
                VerticalAlignment="Top"
                Style="{StaticResource PictureTile}">
          <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
            <Border.Background>
              <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
        </Border>

        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Style="{StaticResource MonoText}"
                     Text="{Binding FileName}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding RelativePath}" />

          <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
            <Border Style="{StaticResource StateTagBorder}" Visibility="{Binding ShowSource, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding SourceText}" />
            </Border>

            <!-- A transparent file is a note, never an error (spec 6.4). -->
            <TextBlock Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource QuietNote}"
                       Text="changes nothing"
                       Visibility="{Binding ChangesNothing, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <controls:PageHeader DockPanel.Dock="Top" Title="Maps">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <!-- Spec 3.1: the page's own search string, bound straight to the page view model. Centred at the
               action height, or the StackPanel stretches box and button to the taller of the two and the box
               reads as two lines. -->
          <Grid Width="200" Height="{StaticResource ActionHeight}" VerticalAlignment="Center">
            <!-- Its own padding, not the style's: a TextBox reserves the whole of Geist's line box, which at this
                 size is taller than an action, so the box keeps 6 at the top and 0 at the bottom to put its
                 glyphs on the buttons' own rows inside the header's 33 px. The left padding is the canvas's:
                 10 to the icon, 15 of icon, 8 to the text. -->
            <!-- Tagged, not named: an element inside the PageHeader's content cannot take an x:Name, because
                 the user control owns a name scope of its own. Ctrl+K finds the box by this marker. -->
            <TextBox Padding="33,6,10,0"
                     AutomationProperties.Name="Search maps"
                     Style="{StaticResource FieldTextBox}"
                     Tag="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Text3, the placeholder's own colour: nothing about a search box hovers or disables. -->
            <controls:Icon Margin="11,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Text3Brush}"
                           Geometry="{StaticResource Icon.Search}"
                           Size="15" />

            <!-- Hit test off, so the placeholder never swallows the click that focuses the box. Centred, so it sits
                 on the same rows the box draws its own text on and nothing shifts when typing starts. -->
            <TextBlock Margin="34,0,11,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search maps">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <!-- Spec 3.1: the zoom belongs to the header row, where nothing the chip row does can move it. -->
          <controls:ZoomSlider Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Maximum="{x:Static pages:MapsViewModel.MaxZoom}"
                               Minimum="{x:Static pages:MapsViewModel.MinZoom}"
                               Value="{Binding Zoom}" />

          <!-- CanWrite, not IsNotBusy: this writes into the game folder, so it is also off while that folder is
               missing and its confirm cannot be reached from a live-looking button (spec 7.8). -->
          <Button Margin="8,0,0,0"
                  Command="{Binding ResetAllCommand}"
                  Content="Reset all to default"
                  controls:Icon.Glyph="{StaticResource Icon.Undo}"
                  IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource OutlineButton}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
      <ListBox HorizontalAlignment="Left"
               ItemContainerStyle="{StaticResource ChipRow}"
               ItemsSource="{Binding Chips}"
               SelectedItem="{Binding SelectedChip}"
               Style="{StaticResource TileListBox}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>

      <!-- Spec 3.1: the row's teaching button, always present, because it is what says maps can be ticked.
           Owner change O7: it says "Select all", because what the chips and the search show is what the user is
           looking at; the tooltip says it in full and the bar's count line confirms what happened. -->
      <Button HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Command="{Binding SelectAllShownCommand}"
              Content="Select all"
              controls:Icon.Glyph="{StaticResource Icon.Check}"
              Style="{StaticResource PlainButton}"
              ToolTip="Ticks the maps the chips and search show" />
    </Grid>

    <!-- Spec 3.1: the only line a first-timer needs, and it goes when a pack arrives. -->
    <TextBlock DockPanel.Dock="Top"
               Margin="0,0,0,12"
               Foreground="{StaticResource Text2Brush}"
               TextWrapping="Wrap"
               Visibility="{Binding ShowFirstRunLine, Converter={StaticResource BoolToVis}}">
      <Run Text="No packs yet. Import a folder of map art on the " /><Hyperlink Command="{Binding DataContext.NavigatePacksCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextBrush}"><Run Text="Packs" /></Hyperlink><Run Text=" page, or add a custom image on " /><Hyperlink Command="{Binding DataContext.NavigateBackgroundsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextBrush}"><Run Text="Backgrounds" /></Hyperlink><Run Text="." />
    </TextBlock>

    <!-- The grid first and the panel second, because WPF tabs in declaration order: a DockPanel would have to
         declare the docked panel before the fill child and Tab would reach it before the cards. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid>
        <!-- Spec 3.1 and 3.3: the grid is a ListBox with extended selection, so Ctrl and Shift clicks, Space, the
             arrow keys and Ctrl+A all come from the control. The tick on each card and the container's own
             IsSelected are the same MapCardViewModel.IsSelected. The container draws no focus rectangle of
             its own: the cards and the chips have their own ring, and the default is a dashed box around the
             whole grid. A local attribute, because a FocusVisualStyle style setter crashes at startup. -->
        <ListBox FocusVisualStyle="{x:Null}"
                 ItemContainerStyle="{StaticResource MapCardItem}"
                 ItemsSource="{Binding Cards}"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Extended"
                 Style="{StaticResource MapGrid}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Top aligned, or a short list comes out with enormous cards. A UniformGrid does not virtualise,
                   which is the point: every container is realised, so the IsSelected binding and Ctrl+A are exact
                   (plan decision A-D10). -->
              <UniformGrid VerticalAlignment="Top"
                           Columns="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- The name and the tag are the container's tooltip, which is the only place they are at the two
                   tightest zoom steps (spec 3.1), and a longer name than the card can draw at any step. -->
              <Border x:Name="Chrome"
                      Padding="{Binding DataContext.CardPadding, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      Style="{StaticResource CardBorder}">
                <StackPanel>
                  <!-- The Viewbox holds the card source's shape at any column width, so a card that has not
                       drawn its preview yet is the same size as one that has and nothing jumps. The size comes
                       from the compositor that renders it, so the two cannot drift apart. Through a OneTime
                       Binding rather than a bare x:Static: the constants are pixel counts and so int, and
                       setting a Double property from an int markup extension throws at load. -->
                  <Grid>
                    <Viewbox Stretch="Uniform">
                      <Grid Width="{Binding Source={x:Static imaging:MapCompositor.CardWidth}, Mode=OneTime}"
                            Height="{Binding Source={x:Static imaging:MapCompositor.CardHeight}, Mode=OneTime}"
                            Background="{StaticResource TileBrush}">
                        <Image RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Preview}"
                               Stretch="UniformToFill" />
                      </Grid>
                    </Viewbox>

                    <!-- Spec 3.1: the tick box, top left of the preview and revealed by the triggers below. Over
                         the Viewbox rather than inside it, for the reason the Missing mark is: the Viewbox would
                         scale these 18 px down with the compositor's 640. -->
                    <CheckBox x:Name="Tick"
                              Margin="6"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              AutomationProperties.Name="Ticked"
                              Focusable="False"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Style="{StaticResource CardTick}"
                              Visibility="Collapsed" />

                    <!-- Spec 3.1: with the tag row gone at 9 and 10, Missing is a mark on the picture. Over the
                         Viewbox rather than inside it: the Viewbox scales the compositor's 640 px down to the
                         card, which at 10 columns would draw these 10 px as 2. -->
                    <Border Width="10"
                            Height="10"
                            Margin="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource MissingFgBrush}"
                            CornerRadius="5">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMissing}" Value="True" />
                                <Condition Binding="{Binding DataContext.ShowMissingMark, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>

                    <!-- Owner change O6: where a card too narrow to hold the pill on its name row draws it
                         instead, over the picture's bottom-left corner. Over the Viewbox rather than inside it,
                         for the reason the Tick and the Missing mark are. The wrapper is what the zoom hides, so
                         the presenter's own Visibility is left to the template trigger below and the two never
                         argue over it. -->
                    <Grid Visibility="{Binding DataContext.ShowTagRow, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                      <ContentPresenter x:Name="PictureTag"
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource CardTagPillOnPicture}"
                                        Visibility="Visible" />
                    </Grid>
                  </Grid>

                  <!-- Owner change O1, as O6 amends it: the name and the tag share the card's one row where the
                       card is wide enough to hold both. There is no second row: a card never grows for its tag,
                       and the pill it cannot fit here is drawn over the picture instead. -->
                  <Grid Margin="2,8,2,0"
                        Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="{Binding DataContext.NameFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- The wrapper is what the zoom hides (at 7 and above there are no tags anywhere), so the
                         presenter's own Visibility is left to the template trigger below. -->
                    <Grid Grid.Column="1"
                          Visibility="{Binding DataContext.ShowTagRow, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                      <ContentPresenter x:Name="NameRowTag"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource CardTagPill}"
                                        Visibility="Collapsed" />
                    </Grid>
                  </Grid>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <!-- Owner changes O1 and O6: a wide card carries the pill on the name's row; a narrow one
                     carries it over the picture's bottom-left corner, so no card ever grows for its tag and the
                     UniformGrid never equalises an empty line into every card. The card's own width decides,
                     rather than the zoom step, because the window can be any width and the panel takes 376 px
                     of it. 200 px is a 16 character pill (the ellipsis ceiling on a picture's name) plus the
                     8 px gap plus a 14 character name at 13 px, plus the card's padding and border. A pack name
                     longer than that takes the width from the name, and ellipsises in its own pill rather than
                     running off the card. -->
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Chrome, Converter={StaticResource WidthAtLeast}, ConverterParameter=200}" Value="True">
                  <Setter TargetName="NameRowTag" Property="Visibility" Value="Visible" />
                  <Setter TargetName="PictureTag" Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <!-- The hover fill is the one the card wore as a Button; the tick box comes with it (spec 3.1). -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Spec 3.1: an empty grid says why in one line, and offers the way back when a search caused it. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Cards.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock HorizontalAlignment="Center"
                     Foreground="{StaticResource Text2Brush}"
                     Text="{Binding EmptyText}"
                     TextWrapping="Wrap" />
          <Button Margin="0,8,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding ClearSearchCommand}"
                  Content="Clear search"
                  Style="{StaticResource PlainButton}"
                  Visibility="{Binding ShowClearSearch, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Spec 3.3: the last child of the cell, so the bar floats over the cards rather than taking a row of
             its own and shortening the grid every time a map is ticked. -->
        <Border Margin="0,0,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Style="{StaticResource SelectionBar}"
                Visibility="{Binding HasTicks, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="4,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" Text="{Binding SelectionText}" />
            <Button Click="OnOpenMenu" Content="Apply pack" Style="{StaticResource OutlineButton}"
                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.ContextMenu>
                <ContextMenu ItemsSource="{Binding PackChoices}" Style="{StaticResource TileContextMenu}">
                  <ContextMenu.ItemContainerStyle>
                    <!-- The fourth setter for the same reason as PanelTileContainer above: TileMenuItem names a
                         row from Text, which a pack row has not got, so without this every row fails that
                         binding and falls back to its header. -->
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TileMenuItem}">
                      <Setter Property="Header" Value="{Binding Name}" />
                      <Setter Property="Command" Value="{Binding DataContext.ApplyPackToTickedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                  </ContextMenu.ItemContainerStyle>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Margin="8,0,0,0" Click="OnOpenMenu" Content="Apply picture" Style="{StaticResource OutlineButton}"
                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.ContextMenu>
                <ContextMenu ItemsSource="{Binding PictureChoices}" Style="{StaticResource TileContextMenu}">
                  <ContextMenu.ItemContainerStyle>
                    <!-- Header rather than Name here: a picture row carries no Name, and TileMenuItem's own
                         Text binding would fail on it exactly as it does on a pack row. -->
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TileMenuItem}">
                      <Setter Property="Header" Value="{Binding Header}" />
                      <Setter Property="Command" Value="{Binding DataContext.ApplyPictureToTickedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                    </Style>
                  </ContextMenu.ItemContainerStyle>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding ResetTickedCommand}" Content="Reset to default"
                    controls:Icon.Glyph="{StaticResource Icon.Undo}" Style="{StaticResource OutlineButton}"
                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="12,0,0,0" Command="{Binding SelectAllShownCommand}" Content="Select all"
                    Style="{StaticResource PlainButton}" ToolTip="Ticks the maps the chips and search show" />
            <Button Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Clear" Style="{StaticResource PlainButton}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Spec 7.2: the right panel for one map, 360 px, open exactly while a card is selected. -->
      <Border Grid.Column="1"
              Width="{StaticResource PanelWidth}"
              Margin="16,0,0,0"
              AutomationProperties.Name="{Binding DisplayName}"
              DataContext="{Binding Panel}"
              Style="{StaticResource CardBorder}"
              Visibility="{Binding DataContext.Panel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="16,12,8,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource QuietNote}" Text="{Binding SetsText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    AutomationProperties.Name="Close"
                    Command="{Binding CloseCommand}"
                    Foreground="{StaticResource Text2Brush}"
                    Style="{StaticResource IconButton}"
                    ToolTip="Close">
              <controls:Icon Geometry="{StaticResource Icon.X}" Size="16" />
            </Button>
          </Grid>

          <!-- The right margin is 4 and the content's is 12, so the overlay scrollbar rides in a gutter of its own
               instead of sitting on top of the tiles. -->
          <ScrollViewer Grid.Row="1"
                        Margin="16,4,4,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <!-- The bottom margin keeps the last row clear of the panel's own edge. -->
            <StackPanel Margin="0,0,12,16">
              <!-- The panel preview's source is 1280x720 (spec 7.2); 16:9 at the panel's own width is 185 px tall. -->
              <Border Height="185" Style="{StaticResource PictureTile}">
                <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
              </Border>

              <!-- Spec 3.2: what the game is showing for this map, in words rather than file names. -->
              <TextBlock Margin="0,12,0,0"
                         Foreground="{StaticResource Text2Brush}"
                         Text="{Binding StatusText}"
                         TextWrapping="Wrap" />

              <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <!-- CanWrite, not IsNotBusy: a reset writes into the game folder (spec 7.8). -->
                <Button Command="{Binding ResetCommand}"
                        Content="Reset this map"
                        controls:Icon.Glyph="{StaticResource Icon.Undo}"
                        IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource OutlineButton}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding OpenFolderCommand}"
                        Content="Open folder"
                        controls:Icon.Glyph="{StaticResource Icon.FolderOpen}"
                        Style="{StaticResource PlainButton}" />
              </StackPanel>

              <!-- Why Reset is off, rather than a disabled button with no explanation (spec 7.8). The empty hint is
                   what switches the line off, the same way the header's done line works. -->
              <TextBlock Margin="0,8,0,0" Text="{Binding ResetHint}" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource QuietNote}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ResetHint}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Spec 3.2: Background or Platforms, one at a time. The page remembers which, so opening the next
                   map lands on the same half. -->
              <Border Margin="0,16,0,0"
                      HorizontalAlignment="Left"
                      Background="{StaticResource Surface2Brush}"
                      CornerRadius="{StaticResource Radius}"
                      Padding="2">
                <StackPanel Orientation="Horizontal">
                  <primitives:ToggleButton Content="Background" IsChecked="{Binding ShowBackgroundSegment}" Style="{StaticResource SegmentControl}" />
                  <primitives:ToggleButton Content="Platforms" IsChecked="{Binding ShowPlatformsSegment}" Style="{StaticResource SegmentControl}" />
                </StackPanel>
              </Border>

              <!-- The -8 right margin is the gutter PanelTile carries on its own right: two tiles across is
                   156 + 8 + 156 in 320 of content, so without it the trailing gutter puts the row 2 px over the
                   panel's width and the second tile wraps. -->
              <ItemsControl Margin="0,12,-8,0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource PanelTileContainer}"
                            ItemTemplate="{StaticResource PanelPictureTile}"
                            ItemsSource="{Binding BackgroundTiles}"
                            Visibility="{Binding ShowBackground, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- Spec 4: the library's own pictures, under the packs. The header is dropped when there are none,
                   because a count of zero says nothing the Add Custom Image button beside it does not. -->
              <Grid Margin="0,4,0,0" Visibility="{Binding ShowBackground, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <primitives:ToggleButton Content="{Binding CustomHeader}"
                                         IsChecked="{Binding CustomExpanded}"
                                         Style="{StaticResource SectionHeaderRow}"
                                         Visibility="{Binding HasCustomPictures, Converter={StaticResource BoolToVis}}" />

                <!-- IsNotBusy, not CanWrite: adding a picture is a library write, and the window it opens is the
                     one thing offered while the game folder is missing (spec 7.1). -->
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{Binding AddPictureCommand}"
                        Content="Add Custom Image"
                        controls:Icon.Glyph="{StaticResource Icon.Plus}"
                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PlainButton}" />
              </Grid>

              <!-- The same tiles the packs above use, so the -8 right margin and the container's automation name
                   are the same too. It belongs to the Background segment, so both conditions have to hold: the
                   strip left open must not follow the user over to Platforms. -->
              <ItemsControl Margin="0,4,-8,0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource PanelTileContainer}"
                            ItemTemplate="{StaticResource PanelPictureTile}"
                            ItemsSource="{Binding CustomTiles}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding ShowBackground}" Value="True" />
                          <Condition Binding="{Binding CustomExpanded}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <ItemsControl Margin="0,12,-8,0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource PanelSetContainer}"
                            ItemTemplate="{StaticResource PanelSetTile}"
                            ItemsSource="{Binding PlatformTiles}"
                            Visibility="{Binding ShowPlatforms, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <primitives:ToggleButton Margin="0,8,0,0"
                                       Content="{Binding FilesHeader}"
                                       IsChecked="{Binding FilesExpanded}"
                                       Style="{StaticResource FilesToggle}"
                                       Visibility="{Binding ShowPlatforms, Converter={StaticResource BoolToVis}}" />

              <!-- The list scrolls inside the panel (spec 7.2), so a map with twenty files does not push everything
                   else out of reach. It belongs to the Platforms segment, so both conditions have to hold. -->
              <ScrollViewer MaxHeight="240"
                            Margin="8,4,0,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding ShowPlatforms}" Value="True" />
                          <Condition Binding="{Binding FilesExpanded}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ItemsControl Focusable="False"
                              ItemContainerStyle="{StaticResource FileContainer}"
                              ItemTemplate="{StaticResource PlatformFile}"
                              ItemsSource="{Binding PlatformFiles}" />
              </ScrollViewer>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>

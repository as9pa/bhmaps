<UserControl x:Class="BhMaps.App.Views.Pages.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BhMaps.App.Behaviors"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:converters="clr-namespace:BhMaps.App.Converters"
             xmlns:imaging="clr-namespace:BhMaps.Core.Imaging;assembly=BhMaps.Core"
             xmlns:pages="clr-namespace:BhMaps.App.ViewModels.Pages"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             behaviors:SizeShortcuts.Target="{Binding}"
             PreviewKeyDown="OnPageKeyDown">
  <!-- Spec 3.2: Escape closes the panel. Escape in the search box is the typed text's first; OnPageKeyDown
       handles that one before this binding can see it. -->
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />
    <converters:WidthAtLeastConverter x:Key="WidthAtLeast" />

    <!-- 2.8: one map is selected at a time, and it is the map the panel is open on. The card is a ListBoxItem,
         so the light border is the control's own selection and the page keeps it on the open card. 3.0: no margin
         here, because the justified panel owns the gutter; the open card's 2 px ring is drawn inside the
         container, so it needs no room of its own either. -->
    <Style x:Key="MapCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileListBoxItem}">
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
      <!-- 3.0: a ToolTip element rather than the bare string, because a tooltip already on screen when the card's
           menu opens has to be closed, and only an element can be. The text comes off the card the tooltip is
           placed on rather than off the DataContext, so one instance shared by every card still says the right
           thing about the card under the pointer. -->
      <Setter Property="ToolTip">
        <Setter.Value>
          <ToolTip Content="{Binding PlacementTarget.DataContext.ToolTipText, RelativeSource={RelativeSource Self}}" />
        </Setter.Value>
      </Setter>
      <Setter Property="ContextMenu" Value="{StaticResource TileMenu}" />
      <EventSetter Event="ContextMenuOpening" Handler="OnCardMenuOpening" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnCardMouseDown" />
      <EventSetter Event="PreviewKeyDown" Handler="OnCardKeyDown" />
    </Style>

    <!-- Owner change O6: the card's state tag, written once here because the card draws it in one of two
         places (the name's row, or the picture's corner).
         Two tags, because Missing is a style of its own rather than a colour on the ordinary one. Each sits in
         a wrapper that carries the visibility, so neither theme style is derived from, and a card with no tag
         asks for no room at all.
         MaxWidth is what makes the trimming below fire: an Auto column hands a pill whatever it asks for, so
         without a ceiling a long pack name would take the name's room and still run off the card. 106 px is the
         measured 97 px of a 16 character tag in the theme's 11 px font, padding included, with room for wider
         glyphs at that length; a picture's name is ellipsised at 16 characters already, so this is where a pack
         name meets the same edge. -->
    <DataTemplate x:Key="CardTagPill">
      <Grid MaxWidth="106">
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowTag}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{StaticResource StateTagBorder}">
            <TextBlock Text="{Binding TagText}" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{StaticResource MissingTagBorder}">
            <TextBlock Text="{Binding TagText}" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>

    <!-- The same pill where it is drawn over the picture: map art is any colour, so the pill is given a ground
         there, and only there, which leaves the name row's pill on the two theme backgrounds it has always had.
         Collapsed on a card with no tag, or the ground would draw as a small empty square in the corner. -->
    <DataTemplate x:Key="CardTagPillOnPicture">
      <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource Radius}" Padding="2">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowTag}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardTagPill}" />
      </Border>
    </DataTemplate>

    <!-- Everything clickable in the panel that is a picture rather than a label: no chrome of its own, the tiles'
         60% focus ring, and the same Surface2 hover the cards use. -->
    <Style x:Key="PanelTileButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{StaticResource Radius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <Border x:Name="Ring"
                      BorderBrush="{StaticResource FocusRingBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius}"
                      IsHitTestVisible="False"
                      Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The panel's Close: the canvas's cross as a geometry rather than a glyph font or an emoji, named for the
         automation tree. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PanelTileButton}">
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="TileCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="QuietNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <!-- The file list's header. The canvas's two chevrons rather than one rotated, which needs no transform
         origin, and they lead the label the way it draws them. Foreground on the style, so the icon inherits the
         colour the label states for itself: the implicit TextBlock style would beat inheritance on the text. -->
    <Style x:Key="FilesToggle" TargetType="primitives:ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="behaviors:Fold.IsOpen" Value="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="primitives:ToggleButton">
            <Grid>
              <Border x:Name="Chrome"
                      Background="Transparent"
                      CornerRadius="{StaticResource Radius}"
                      Padding="8,6">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Style="{StaticResource FoldChevron}" />
                  <TextBlock Foreground="{StaticResource Text2Brush}"
                             Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
              </Border>
              <Border x:Name="Ring"
                      BorderBrush="{StaticResource FocusRingBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius}"
                      IsHitTestVisible="False"
                      Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Without these the container a generated item sits in announces the view model's type name. On the container
         and not on the tile: a Border has no automation peer of its own, so a name set there reaches nothing. -->
    <Style x:Key="PanelTileContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    </Style>

    <Style x:Key="PanelSetContainer" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding PackName}" />
    </Style>

    <!-- One background on offer for this map. The whole tile carries the menu, so a right click anywhere on it and
         the menu button open the same five lines, and Shift+F10 finds it through TileMenus. -->
    <DataTemplate x:Key="PanelPictureTile">
      <Border x:Name="Tile"
              ContextMenu="{StaticResource TileMenu}"
              Focusable="True"
              FocusVisualStyle="{x:Null}"
              Style="{StaticResource PanelTile}">
        <StackPanel>
          <Grid>
            <Border Height="80" Style="{StaticResource PictureTile}">
              <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Border>

            <Border x:Name="InGameTick"
                    Margin="0,4,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgBrush}"
                    CornerRadius="4"
                    Padding="4,3"
                    Visibility="Collapsed">
              <Path Data="M0,3.4 L2.8,6.2 L8,0.6"
                    Stroke="{StaticResource TextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Border>

            <!-- CanWrite, not IsNotBusy: an apply writes into the game folder, so it is also off while that folder
                 is missing (spec 7.8). Revealed by opacity rather than Visibility: a collapsed button cannot be
                 tabbed to, so it would be mouse-only. -->
            <StackPanel x:Name="Actions"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Opacity="0">
              <Button AutomationProperties.Name="{Binding ApplyText}"
                      Command="{Binding ApplyCommand}"
                      Content="{Binding ApplyText}"
                      IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                      Style="{StaticResource TileAction}" />
              <Button Margin="4,0,0,0"
                      AutomationProperties.Name="More actions"
                      Click="OnTileMenuButton"
                      Style="{StaticResource TileAction}">
                <controls:Icon Geometry="{StaticResource Icon.Dots}" Size="14" />
              </Button>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,6,0,0" Style="{StaticResource TileCaption}" Text="{Binding Title}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsInGame}" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="InGameTick" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource Surface2Brush}" />
        </Trigger>

        <!-- An open menu takes the mouse, so the tile stops being hovered and the button that opened the menu
             would vanish while its own menu is still on screen. The menu is the tile's own instance, because
             TileMenu is x:Shared="False". -->
        <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=Tile}" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One platform set on offer for this map. The same tile as a picture's, over the map's current background,
         and the pack's name under it. Its menu is the set's three lines rather than a picture's five. -->
    <DataTemplate x:Key="PanelSetTile">
      <Border x:Name="Tile"
              ContextMenu="{StaticResource TileMenu}"
              Focusable="True"
              FocusVisualStyle="{x:Null}"
              Style="{StaticResource PanelTile}">
        <StackPanel>
          <Grid>
            <Border Height="88" Style="{StaticResource PictureTile}">
              <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Border>

            <Border x:Name="InGameTick"
                    Margin="0,4,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgBrush}"
                    CornerRadius="4"
                    Padding="4,3"
                    Visibility="Collapsed">
              <Path Data="M0,3.4 L2.8,6.2 L8,0.6"
                    Stroke="{StaticResource TextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Border>

            <StackPanel x:Name="Actions"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Opacity="0">
              <Button AutomationProperties.Name="Apply"
                      Command="{Binding ApplyToMapCommand}"
                      Content="Apply"
                      IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                      Style="{StaticResource TileAction}" />
              <Button Margin="4,0,0,0"
                      AutomationProperties.Name="More actions"
                      Click="OnTileMenuButton"
                      Style="{StaticResource TileAction}">
                <controls:Icon Geometry="{StaticResource Icon.Dots}" Size="14" />
              </Button>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,6,0,0" Style="{StaticResource TileCaption}" Text="{Binding PackName}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding InGame}" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="InGameTick" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource Surface2Brush}" />
        </Trigger>

        <!-- An open menu takes the mouse, so the tile stops being hovered and the button that opened the menu
             would vanish while its own menu is still on screen. The menu is the tile's own instance, because
             TileMenu is x:Shared="False". -->
        <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=Tile}" Value="True">
          <Setter TargetName="Actions" Property="Opacity" Value="1" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One platform file: its thumbnail, its name, and where the game's copy came from. -->
    <DataTemplate x:Key="PlatformFile">
      <Grid x:Name="Row"
            Margin="0,0,0,8"
            Focusable="True"
            FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="48"
                Height="27"
                VerticalAlignment="Top"
                Style="{StaticResource PictureTile}">
          <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
            <Border.Background>
              <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
        </Border>

        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Style="{StaticResource MonoText}"
                     Text="{Binding FileName}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding RelativePath}" />

          <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
            <Border Style="{StaticResource StateTagBorder}" Visibility="{Binding ShowSource, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding SourceText}" />
            </Border>

            <!-- A transparent file is a note, never an error (spec 6.4). -->
            <TextBlock Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource QuietNote}"
                       Text="changes nothing"
                       Visibility="{Binding ChangesNothing, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>

        <!-- Revealed by opacity rather than Visibility, the way the tiles reveal theirs: a collapsed button
             cannot be tabbed to. Collapsed only where the game has no copy of the file to edit. -->
        <Button x:Name="EditAction"
                Grid.Column="2"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding FileName, StringFormat='Edit {0}'}"
                Command="{Binding EditCommand}"
                Content="Edit"
                Opacity="0"
                Style="{StaticResource TileAction}"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="EditAction" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="EditAction" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <controls:PageHeader DockPanel.Dock="Top" PageMenu="{Binding PageMenu}" Title="Maps">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <!-- Spec 3.1: the page's own search string, bound straight to the page view model. Centred at the
               action height, or the StackPanel stretches box and button to the taller of the two and the box
               reads as two lines. -->
          <Grid Width="200" Height="{StaticResource ActionHeight}" VerticalAlignment="Center">
            <!-- Its own padding, not the style's: a TextBox reserves the whole of Geist's line box, which at this
                 size is taller than an action, so the box keeps 6 at the top and 0 at the bottom to put its
                 glyphs on the buttons' own rows inside the header's 33 px. The left padding is the canvas's:
                 10 to the icon, 15 of icon, 8 to the text. -->
            <!-- Tagged, not named: an element inside the PageHeader's content cannot take an x:Name, because
                 the user control owns a name scope of its own. Ctrl+K finds the box by this marker. -->
            <TextBox Padding="33,6,10,0"
                     AutomationProperties.Name="Search maps"
                     Style="{StaticResource FieldTextBox}"
                     Tag="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Text3, the placeholder's own colour: nothing about a search box hovers or disables. -->
            <controls:Icon Margin="11,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Text3Brush}"
                           Geometry="{StaticResource Icon.Search}"
                           Size="15" />

            <!-- Hit test off, so the placeholder never swallows the click that focuses the box. Centred, so it sits
                 on the same rows the box draws its own text on and nothing shifts when typing starts. -->
            <TextBlock Margin="34,0,11,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search maps">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <!-- Spec 3.1: the size belongs to the header row, where nothing the chip row does can move it. -->
          <controls:SizePicker Margin="16,0,0,0" VerticalAlignment="Center" Value="{Binding TileSize}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
      <ListBox HorizontalAlignment="Left"
               ItemContainerStyle="{StaticResource ChipRow}"
               ItemsSource="{Binding Chips}"
               SelectedItem="{Binding SelectedChip}"
               Style="{StaticResource TileListBox}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
    </Grid>

    <!-- Spec 3.1: the only line a first-timer needs, and it goes when a pack arrives. -->
    <TextBlock DockPanel.Dock="Top"
               Margin="0,0,0,12"
               Foreground="{StaticResource Text2Brush}"
               TextWrapping="Wrap"
               Visibility="{Binding ShowFirstRunLine, Converter={StaticResource BoolToVis}}">
      <Run Text="No packs yet. Import a folder of map art on the " /><Hyperlink Command="{Binding DataContext.NavigatePacksCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextBrush}"><Run Text="Packs" /></Hyperlink><Run Text=" page, or add an image on " /><Hyperlink Command="{Binding DataContext.NavigateBackgroundsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextBrush}"><Run Text="Backgrounds" /></Hyperlink><Run Text="." />
    </TextBlock>

    <!-- The grid first and the panel second, because WPF tabs in declaration order: a DockPanel would have to
         declare the docked panel before the fill child and Tab would reach it before the cards. -->
    <Grid>
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.GameFolderMissing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid>
          <!-- 2.8: the grid is a ListBox with single selection, and the selected card is the one the panel is open
               on: the container's own IsSelected is MapCardViewModel.IsSelected. The container draws no focus
               rectangle of its own: the cards and the chips have their own ring, and the default is a dashed box
               around the whole grid. A local attribute, because a FocusVisualStyle style setter crashes at
               startup. -->
          <ListBox FocusVisualStyle="{x:Null}"
                   ItemContainerStyle="{StaticResource MapCardItem}"
                   ItemsSource="{Binding Cards}"
                   KeyboardNavigation.DirectionalNavigation="Contained"
                   ScrollViewer.CanContentScroll="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   SelectionMode="Single"
                   Style="{StaticResource TileListBox}">
            <ListBox.Resources>
              <!-- The ScrollViewer is inside the ListBox's own template, so the behaviour reaches it through an
                   implicit style rather than as an attribute (spec 10). -->
              <Style TargetType="ScrollViewer">
                <Setter Property="behaviors:SmoothScroll.IsEnabled" Value="True" />
              </Style>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Top aligned, or a short list comes out with a huge gap under it. 3.0: a JustifiedPanel
                     rather than the 2.8 WrapPanel, which left whatever did not fit as a hole down the right edge
                     beside the open panel. The size is a target width; the panel fits as many cards across as it
                     can and shares the rest of the row out over them, so the grid always reaches the edge. The
                     gutter is the panel's Gap, so the cards themselves carry no margin. -->
                <controls:JustifiedPanel VerticalAlignment="Top"
                                         Gap="12"
                                         TargetWidth="{Binding DataContext.TargetCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- The name and the tag are the container's tooltip, which is the only place they are at the two
                     tightest zoom steps (spec 3.1), and a longer name than the card can draw at any step. -->
                <Border x:Name="Chrome"
                        Padding="{Binding DataContext.CardPadding, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <!-- The Viewbox holds the card source's shape at any card width, so a card that has not
                         drawn its preview yet is the same size as one that has and nothing jumps, and the card's
                         height follows its width rather than being set anywhere. The size comes
                         from the compositor that renders it, so the two cannot drift apart. Through a OneTime
                         Binding rather than a bare x:Static: the constants are pixel counts and so int, and
                         setting a Double property from an int markup extension throws at load. -->
                    <Grid>
                      <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding Source={x:Static imaging:MapCompositor.CardWidth}, Mode=OneTime}"
                              Height="{Binding Source={x:Static imaging:MapCompositor.CardHeight}, Mode=OneTime}"
                              Background="{StaticResource TileBrush}">
                          <Image RenderOptions.BitmapScalingMode="HighQuality"
                                 Source="{Binding Preview}"
                                 Stretch="UniformToFill" />
                        </Grid>
                      </Viewbox>

                      <!-- Spec 3.1: with the tag row gone at 9 and 10, Missing is a mark on the picture. Over the
                           Viewbox rather than inside it: the Viewbox scales the compositor's 640 px down to the
                           card, which at 10 columns would draw these 10 px as 2. -->
                      <Border Width="10"
                              Height="10"
                              Margin="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Background="{StaticResource MissingFgBrush}"
                              CornerRadius="5">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsMissing}" Value="True" />
                                  <Condition Binding="{Binding DataContext.ShowMissingMark, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>

                      <!-- Owner change O6: where a card too narrow to hold the pill on its name row draws it
                           instead, over the picture's bottom-left corner. Over the Viewbox rather than inside it,
                           for the reason the Missing mark is. The wrapper is what the zoom hides, so
                           the presenter's own Visibility is left to the template trigger below and the two never
                           argue over it. -->
                      <Grid Visibility="{Binding DataContext.ShowTagRow, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                        <ContentPresenter x:Name="PictureTag"
                                          Margin="6"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom"
                                          Content="{Binding}"
                                          ContentTemplate="{StaticResource CardTagPillOnPicture}"
                                          Visibility="Visible" />
                      </Grid>
                    </Grid>

                    <!-- Owner change O1, as O6 amends it: the name and the tag share the card's one row where the
                         card is wide enough to hold both. There is no second row: a card never grows for its tag,
                         and the pill it cannot fit here is drawn over the picture instead. -->
                    <Grid Margin="2,8,2,0"
                          Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBlock VerticalAlignment="Center"
                                 FontSize="{Binding DataContext.NameFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                 Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- The wrapper is what the zoom hides (at 7 and above there are no tags anywhere), so the
                           presenter's own Visibility is left to the template trigger below. -->
                      <Grid Grid.Column="1"
                            Visibility="{Binding DataContext.ShowTagRow, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                        <ContentPresenter x:Name="NameRowTag"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{Binding}"
                                          ContentTemplate="{StaticResource CardTagPill}"
                                          Visibility="Collapsed" />
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <!-- Owner changes O1 and O6: a wide card carries the pill on the name's row; a narrow one
                       carries it over the picture's bottom-left corner, so no card ever grows for its tag and a
                       row is never as tall as an empty line in one card. The card's own width decides,
                       rather than the zoom step, because the window can be any width and the panel takes 376 px
                       of it. 200 px is a 16 character pill (the ellipsis ceiling on a picture's name) plus the
                       8 px gap plus a 14 character name at 13 px, plus the card's padding and border. A pack name
                       longer than that takes the width from the name, and ellipsises in its own pill rather than
                       running off the card. -->
                  <DataTrigger Binding="{Binding ActualWidth, ElementName=Chrome, Converter={StaticResource WidthAtLeast}, ConverterParameter=200}" Value="True">
                    <Setter TargetName="NameRowTag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PictureTag" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- The hover fill is the one the card wore as a Button (spec 3.1). -->
                  <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
                  </DataTrigger>

                  <!-- 3.0: the open card wears the hover fill for as long as its panel is open, so the accent ring
                       the container draws is not the only thing saying which card the panel belongs to. A fill
                       rather than anything sized: the ring is an overlay at the card's edge and the picture sits
                       inside the card's padding, so neither one covers the picture or moves a card. -->
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2Brush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Spec 3.1: an empty grid says why in one line, and offers the way back when a search caused it. -->
          <controls:EmptyState ActionCommand="{Binding ClearSearchCommand}"
                               ActionText="{Binding EmptyActionText}"
                               Text="{Binding EmptyText}">
            <controls:EmptyState.Style>
              <Style TargetType="controls:EmptyState">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Cards.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:EmptyState.Style>
          </controls:EmptyState>
        </Grid>

        <!-- Spec 7.2: the right panel for one map, 420 px (3.0), open exactly while a card is selected. -->
        <Border Grid.Column="1"
                Width="{StaticResource PanelWidth}"
                Margin="24,0,0,0"
                AutomationProperties.Name="{Binding DisplayName}"
                DataContext="{Binding Panel}"
                Padding="16"
                Style="{StaticResource CardBorder}"
                Visibility="{Binding DataContext.Panel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="{StaticResource FontEmphasis}" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource QuietNote}" Text="{Binding SetsText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0"
                           Style="{StaticResource QuietNote}"
                           Text="{Binding ThumbnailNote}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasThumbnailNote, Converter={StaticResource BoolToVis}}" />
              </StackPanel>

              <Button Grid.Column="1"
                      AutomationProperties.Name="Close"
                      Command="{Binding CloseCommand}"
                      Foreground="{StaticResource Text2Brush}"
                      Style="{StaticResource IconButton}"
                      ToolTip="Close">
                <controls:Icon Geometry="{StaticResource Icon.X}" Size="16" />
              </Button>
            </Grid>

            <!-- 3.0: the panel's 16 px inset is the Border's padding, so nothing in here repeats it. The content
                 keeps a right margin of its own, so the overlay scrollbar rides in a gutter instead of sitting on
                 top of the tiles. -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:SmoothScroll.IsEnabled="True"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,8,0">
                <!-- The panel preview's source is 1280x720 (spec 7.2); 16:9 at the panel's own width is 185 px tall. -->
                <Border Height="185" Style="{StaticResource PictureTile}">
                  <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                </Border>

                <!-- Spec 3.2: what the game is showing for this map, in words rather than file names. -->
                <TextBlock Margin="0,12,0,0"
                           Foreground="{StaticResource Text2Brush}"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                  <!-- CanWrite, not IsNotBusy: a reset writes into the game folder (spec 7.8). -->
                  <Button Command="{Binding ResetCommand}"
                          Content="Reset this map"
                          controls:Icon.Glyph="{StaticResource Icon.Undo}"
                          IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                          Style="{StaticResource OutlineButton}" />
                  <Button Margin="8,0,0,0"
                          Command="{Binding OpenFolderCommand}"
                          Content="Open folder"
                          controls:Icon.Glyph="{StaticResource Icon.FolderOpen}"
                          Style="{StaticResource PlainButton}" />
                </StackPanel>

                <!-- Why Reset is off, rather than a disabled button with no explanation (spec 7.8). The empty hint is
                     what switches the line off, the same way the header's done line works. -->
                <TextBlock Margin="0,8,0,0" Text="{Binding ResetHint}" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource QuietNote}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetHint}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <!-- Spec 7: the two halves are stacked rather than segmented, so one map's whole state is on the
                     screen at once. The header is the one a page already puts over a section, so a section in the
                     panel reads as the same kind of thing. -->
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderText}" Text="Background" />

                <!-- The -8 right margin is the gutter PanelTile carries on its own right: two tiles across is
                     156 + 8 + 156 in 320 of content, so without it the trailing gutter puts the row 2 px over the
                     panel's width and the second tile wraps. -->
                <ItemsControl Margin="0,8,-8,0"
                              Focusable="False"
                              ItemContainerStyle="{StaticResource PanelTileContainer}"
                              ItemTemplate="{StaticResource PanelPictureTile}"
                              ItemsSource="{Binding Backgrounds}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Spec 3: the any-map pictures, under the packs, one strip per pack and then the game's own. A
                     pack with none of them is no strip at all, because a count of zero says nothing the Add Image
                     button beside it does not. -->
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Every strip folds on its own and starts folded, so the panel opens on the status line and the
                       pack tiles alone; a strip's thumbnails are a file read each, and they wait for the click on
                       its header. The tiles are the ones the packs above use, so the -8 right margin and the
                       container's automation name are the same too. -->
                  <ItemsControl Focusable="False"
                                ItemsSource="{Binding PictureGroups}"
                                Visibility="{Binding HasCustomPictures, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <primitives:ToggleButton Content="{Binding Header}"
                                                   IsChecked="{Binding IsOpen}"
                                                   Style="{StaticResource SectionHeaderRow}" />

                          <ItemsControl Margin="0,4,-8,0"
                                        behaviors:Fold.Animate="True"
                                        Focusable="False"
                                        ItemContainerStyle="{StaticResource PanelTileContainer}"
                                        ItemTemplate="{StaticResource PanelPictureTile}"
                                        ItemsSource="{Binding Tiles}"
                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- IsNotBusy, not CanWrite: adding a picture is a library write, and the window it opens is the
                       one thing offered while the game folder is missing (spec 7.1). -->
                  <Button Grid.Column="1"
                          VerticalAlignment="Top"
                          Command="{Binding AddPictureCommand}"
                          Content="Add Image"
                          controls:Icon.Glyph="{StaticResource Icon.Plus}"
                          IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                          Style="{StaticResource PlainButton}" />
                </Grid>

                <!-- One hairline, not a box or a gap: the least chrome that still says the two sections are
                     separate things. -->
                <Border Margin="0,16,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />

                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderText}" Text="Platforms" />

                <ItemsControl Margin="0,8,-8,0"
                              Focusable="False"
                              ItemContainerStyle="{StaticResource PanelSetContainer}"
                              ItemTemplate="{StaticResource PanelSetTile}"
                              ItemsSource="{Binding Platforms}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <primitives:ToggleButton Margin="0,8,0,0"
                                         Content="{Binding FilesHeader}"
                                         IsChecked="{Binding FilesOpen}"
                                         Style="{StaticResource FilesToggle}" />

                <!-- The list scrolls inside the panel (spec 7.2), so a map with twenty files does not push everything
                     else out of reach. -->
                <ScrollViewer MaxHeight="240"
                              Margin="8,4,0,0"
                              behaviors:Fold.Animate="True"
                              HorizontalScrollBarVisibility="Disabled"
                              behaviors:SmoothScroll.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding FilesOpen, Converter={StaticResource BoolToVis}}">
                  <ItemsControl Focusable="False"
                                ItemContainerStyle="{StaticResource FileContainer}"
                                ItemTemplate="{StaticResource PlatformFile}"
                                ItemsSource="{Binding Files}" />
                </ScrollViewer>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <!-- 3.0: with no game folder there is nothing on this page to read or write, so the page itself says so
           and offers the one thing that fixes it. The picker, the save and the rescan behind it are the Settings
           page's own command; there is one of them. -->
      <controls:EmptyState ActionCommand="{Binding DataContext.SettingsPage.ChangeGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           ActionText="Choose folder"
                           Text="Game folder not found. Choose the Brawlhalla mapArt folder to continue."
                           Visibility="{Binding DataContext.GameFolderMissing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DockPanel>
</UserControl>

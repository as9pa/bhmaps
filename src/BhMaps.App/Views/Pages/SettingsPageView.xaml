<UserControl x:Class="BhMaps.App.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:converters="clr-namespace:BhMaps.App.Converters">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:MiddleTruncateConverter x:Key="MiddleTruncate" />

    <!-- Page-local, because 3.0's shape is three sections of the same three cells and nothing else in the app
         is built that way. Labels in the body style, values in MonoText, errors in MissingFg. -->
    <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A form section heading: FontSection is the page-title size, so the sections use the step below it. -->
    <Style x:Key="SettingSection" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,28,0,4" />
      <Setter Property="FontSize" Value="{StaticResource FontEmphasis}" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>

    <Style x:Key="SettingValue" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <!-- One line per setting: a long path is trimmed rather than wrapped, and the tooltip carries the rest. -->
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The sentence under a value, saying what the row's button does. -->
    <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingError" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingCell" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingActions" TargetType="StackPanel">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingRule" TargetType="Border">
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="{StaticResource LineBrush}" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <controls:PageHeader DockPanel.Dock="Top" Title="Settings" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- Every row here writes something, so none of them is offered while a long operation is running. The
           three grids share one scope so their action columns line up as one column down the whole form. -->
      <StackPanel MaxWidth="760"
                  HorizontalAlignment="Left"
                  Grid.IsSharedSizeScope="True"
                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Margin="0,0,0,12"
                   Foreground="{StaticResource Text3Brush}"
                   Text="{Binding OverrideNote}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasOverrideNote, Converter={StaticResource BoolToVis}}" />

        <TextBlock Margin="0,0,0,4" Style="{StaticResource SettingSection}" Text="Folders" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingActions" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
          </Grid.RowDefinitions>

          <!-- Game folder. Both buttons have to fit the action column, so the text is short and the sentence
               the row used to say is the tooltip; the automation name stays the long one. -->
          <Border Grid.Row="0" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Game folder" />
          <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingCell}">
            <TextBlock Style="{StaticResource SettingValue}"
                       Text="{Binding GamePath, Converter={StaticResource MiddleTruncate}, ConverterParameter=44}"
                       ToolTip="{Binding GamePath}" />
            <TextBlock Style="{StaticResource SettingError}"
                       Text="{Binding GameError}"
                       Visibility="{Binding HasGameError, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Style="{StaticResource SettingActions}">
            <Button AutomationProperties.Name="Change game folder"
                    Command="{Binding ChangeGameCommand}"
                    Content="Change"
                    Style="{StaticResource OutlineButton}"
                    ToolTip="Change game folder" />
            <Button Margin="8,0,0,0"
                    AutomationProperties.Name="Open game folder"
                    Command="{Binding OpenGameCommand}"
                    Content="Open"
                    controls:Icon.Glyph="{StaticResource Icon.FolderOpen}"
                    Style="{StaticResource PlainButton}"
                    ToolTip="Open game folder" />
          </StackPanel>

          <!-- Library -->
          <Border Grid.Row="1" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Library" />
          <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCell}">
            <TextBlock Style="{StaticResource SettingValue}"
                       Text="{Binding LibraryPath, Converter={StaticResource MiddleTruncate}, ConverterParameter=44}"
                       ToolTip="{Binding LibraryPath}" />
            <TextBlock Style="{StaticResource SettingError}"
                       Text="{Binding LibraryError}"
                       Visibility="{Binding HasLibraryError, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Style="{StaticResource SettingActions}">
            <Button AutomationProperties.Name="Change library folder"
                    Command="{Binding ChangeLibraryCommand}"
                    Content="Change"
                    Style="{StaticResource OutlineButton}"
                    ToolTip="Change library folder" />
            <Button Margin="8,0,0,0"
                    AutomationProperties.Name="Open library folder"
                    Command="{Binding OpenLibraryCommand}"
                    Content="Open"
                    controls:Icon.Glyph="{StaticResource Icon.FolderOpen}"
                    Style="{StaticResource PlainButton}"
                    ToolTip="Open library folder" />
          </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SettingSection}" Text="Game" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingActions" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
          </Grid.RowDefinitions>

          <!-- Game data. The sentence is prose, not a value, so it stays in the body style. -->
          <Border Grid.Row="0" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Game data" />
          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,10"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Text2Brush}"
                     Text="{Binding GameDataStatus}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding GameDataStatus}" />
          <StackPanel Grid.Row="0" Style="{StaticResource SettingActions}">
            <Button Command="{Binding RefreshGameDataCommand}" Content="Refresh now" controls:Icon.Glyph="{StaticResource Icon.Refresh}" Style="{StaticResource OutlineButton}" />
          </StackPanel>

          <!-- Default pack -->
          <Border Grid.Row="1" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Default pack" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,10"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Text2Brush}"
                     Text="Copies the game's own map art into the Default pack, so Reset has something to put back."
                     TextWrapping="Wrap" />
          <StackPanel Grid.Row="1" Style="{StaticResource SettingActions}">
            <!-- The only row here that reads the game folder, so the only one that also needs CanWrite; the
                 panel above already ands in IsNotBusy for every row (spec 7.8). -->
            <Button AutomationProperties.Name="Capture the Default pack"
                    Command="{Binding CaptureDefaultsCommand}"
                    Content="Capture"
                    controls:Icon.Glyph="{StaticResource Icon.Camera}"
                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource OutlineButton}"
                    ToolTip="Capture the Default pack" />
          </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SettingSection}" Text="Updates" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="SettingActions" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
          </Grid.RowDefinitions>

          <!-- Version -->
          <Border Grid.Row="0" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Version" />
          <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingCell}">
            <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Version}" />

            <!-- Spec 7.3: one second line for every state, available, up to date, never checked, failed, and the
                 two download states. The view model owns which one it is. -->
            <TextBlock Style="{StaticResource SettingHelp}"
                       Text="{Binding UpdateLine}"
                       Visibility="{Binding HasUpdateLine, Converter={StaticResource BoolToVis}}" />
            <ProgressBar Margin="0,8,0,0"
                         Style="{StaticResource ThinProgress}"
                         Value="{Binding DownloadProgress, Mode=OneWay}"
                         Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Style="{StaticResource SettingActions}">
            <Button Command="{Binding CancelDownloadCommand}"
                    Content="Cancel"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PlainButton}"
                    Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}" />
            <Button Margin="8,0,0,0"
                    Command="{Binding WhatChangedCommand}"
                    Content="What changed"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PlainButton}"
                    Visibility="{Binding ShowWhatChanged, Converter={StaticResource BoolToVis}}" />
            <Button Margin="8,0,0,0"
                    Command="{Binding UpdateCommand}"
                    Content="{Binding UpdateButtonText}"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Downloads the new exe and swaps it in when you close BhMaps."
                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <!-- Updates (spec 7.2, 7.3). Under Version, because it is about the row above it. What the check costs
               is the switch's tooltip, and when it last ran is the Version row's line: it is the same check. -->
          <Border Grid.Row="1" Style="{StaticResource SettingRule}" />
          <!-- No label of its own: the section is called Updates, and the switch's text says the rest. -->
          <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCell}">
            <CheckBox AutomationProperties.Name="Check for updates when BhMaps starts"
                      Content="Check for updates when BhMaps starts"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      Foreground="{StaticResource TextBrush}"
                      IsChecked="{Binding CheckForUpdates}"
                      ToolTip="Once a day, one small request to github.com. Nothing is sent about you or your library." />
          </StackPanel>
          <StackPanel Grid.Row="1" Style="{StaticResource SettingActions}">
            <Button Command="{Binding CheckNowCommand}"
                    Content="Check now"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PlainButton}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

<UserControl x:Class="BhMaps.App.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
             xmlns:settings="clr-namespace:BhMaps.Core.Settings;assembly=BhMaps.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Page-local, because spec 7.6's shape is six rows of the same three cells and nothing else in the app
         is built that way. Labels in the body style, values in MonoText, errors in MissingFg. -->
    <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingValue" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <!-- One line per setting: a long path is trimmed rather than wrapped, and the tooltip carries the rest. -->
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SettingError" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingCell" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingActions" TargetType="StackPanel">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingRule" TargetType="Border">
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="{StaticResource LineBrush}" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">
    <controls:PageHeader DockPanel.Dock="Top" Title="Settings" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- Every row here writes something, so none of them is offered while a long operation is running. -->
      <StackPanel IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Margin="0,0,0,12"
                   Foreground="{StaticResource Text3Brush}"
                   Text="{Binding OverrideNote}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasOverrideNote, Converter={StaticResource BoolToVis}}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
            <RowDefinition Height="Auto" MinHeight="56" />
          </Grid.RowDefinitions>

          <!-- Game folder -->
          <Border Grid.Row="0" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Game folder" />
          <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingCell}">
            <TextBlock Style="{StaticResource SettingValue}" Text="{Binding GamePath}" ToolTip="{Binding GamePath}" />
            <TextBlock Style="{StaticResource SettingError}"
                       Text="{Binding GameError}"
                       Visibility="{Binding HasGameError, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Style="{StaticResource SettingActions}">
            <Button AutomationProperties.Name="Change game folder"
                    Command="{Binding ChangeGameCommand}"
                    Content="Change"
                    Style="{StaticResource OutlineButton}" />
            <Button Margin="8,0,0,0"
                    AutomationProperties.Name="Open game folder"
                    Command="{Binding OpenGameCommand}"
                    Content="Open"
                    Style="{StaticResource PlainButton}" />
          </StackPanel>

          <!-- Library -->
          <Border Grid.Row="1" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Library" />
          <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCell}">
            <TextBlock Style="{StaticResource SettingValue}" Text="{Binding LibraryPath}" ToolTip="{Binding LibraryPath}" />
            <TextBlock Style="{StaticResource SettingError}"
                       Text="{Binding LibraryError}"
                       Visibility="{Binding HasLibraryError, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Style="{StaticResource SettingActions}">
            <Button AutomationProperties.Name="Change library folder"
                    Command="{Binding ChangeLibraryCommand}"
                    Content="Change"
                    Style="{StaticResource OutlineButton}" />
            <Button Margin="8,0,0,0"
                    AutomationProperties.Name="Open library folder"
                    Command="{Binding OpenLibraryCommand}"
                    Content="Open"
                    Style="{StaticResource PlainButton}" />
          </StackPanel>

          <!-- Game data. The sentence is prose, not a value, so it stays in the body style. -->
          <Border Grid.Row="2" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Game data" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,10"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Text2Brush}"
                     Text="{Binding GameDataStatus}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding GameDataStatus}" />
          <StackPanel Grid.Row="2" Style="{StaticResource SettingActions}">
            <Button Command="{Binding RefreshGameDataCommand}" Content="Refresh now" Style="{StaticResource OutlineButton}" />
          </StackPanel>

          <!-- Defaults -->
          <Border Grid.Row="3" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Defaults" />
          <StackPanel Grid.Row="3" Style="{StaticResource SettingActions}">
            <!-- The only row here that reads the game folder, so the only one that also needs CanWrite; the
                 panel above already ands in IsNotBusy for every row (spec 7.8). -->
            <Button Command="{Binding CaptureDefaultsCommand}"
                    Content="Capture defaults"
                    IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource OutlineButton}" />
          </StackPanel>

          <!-- While the game runs -->
          <Border Grid.Row="4" Style="{StaticResource SettingRule}" />
          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="While the game runs" />
          <ComboBox Grid.Row="4"
                    Grid.Column="1"
                    AutomationProperties.Name="While the game runs"
                    Width="180"
                    Margin="0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedValue="{Binding WhileRunning}"
                    SelectedValuePath="Tag">
            <ComboBoxItem Content="Restart and apply" Tag="{x:Static settings:AppSettings.RestartWhileRunning}" />
            <ComboBoxItem Content="Apply live" Tag="{x:Static settings:AppSettings.LiveWhileRunning}" />
          </ComboBox>

          <!-- Version -->
          <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Version" />
          <TextBlock Grid.Row="5"
                     Grid.Column="1"
                     Margin="0,10"
                     VerticalAlignment="Center"
                     Style="{StaticResource SettingValue}"
                     Text="{Binding Version}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

<Window x:Class="BhMaps.App.Views.PlatformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
        xmlns:converters="clr-namespace:BhMaps.App.Converters"
        xmlns:vm="clr-namespace:BhMaps.App.ViewModels"
        Title="{Binding Title}" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
  <!-- Spec 9: the strip's two buttons from the keyboard, so a set of maps is walked without the mouse. -->
  <Window.InputBindings>
    <KeyBinding Key="PageUp" Command="{Binding PreviousMapCommand}" />
    <KeyBinding Key="PageDown" Command="{Binding NextMapCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- Only the fit switch needs it: its second button is on exactly when the property is off. -->
    <converters:InverseBooleanConverter x:Key="InverseBool" />

    <!-- One label style carries the whole panel's vertical rhythm, so a block is a label and its control. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <!-- Its own Text drives the visibility, so a valid name takes the line back rather than leaving a gap. -->
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A row's own line under its readout, indented to the file name. Its own Text drives the visibility, so a
         row with nothing to say keeps the list as tight as it was (spec 5.2). -->
    <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
      <Setter Property="Margin" Value="56,2,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The Reset in a slider's label: a word, not a button, so the label reads as one line. -->
    <Style x:Key="ResetLink" TargetType="Button" BasedOn="{StaticResource PlainButton}">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <Style x:Key="Readout" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <!-- Cells rather than docking, so the order the eye reads is the order Tab walks: a DockPanel would have to
       declare the bottom button row before the panel whose values it saves. -->
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Spec 9: which map of the set the editor is on, above the preview it belongs to. One map is every
             other way into the editor, so the strip and its row go with it. -->
        <Grid Margin="16,16,16,0" Visibility="{Binding HasManyMaps, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button AutomationProperties.Name="Previous map"
                  Command="{Binding PreviousMapCommand}"
                  FocusVisualStyle="{StaticResource DialogFocusRing}"
                  Style="{StaticResource OutlineButton}"
                  controls:Icon.Glyph="{StaticResource Icon.ChevronLeft}" />
          <StackPanel Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="{Binding CurrentMapName}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource HintText}"
                       Text="{Binding MapStripText}" />
          </StackPanel>
          <Button Grid.Column="2"
                  AutomationProperties.Name="Next map"
                  Command="{Binding NextMapCommand}"
                  FocusVisualStyle="{StaticResource DialogFocusRing}"
                  Style="{StaticResource OutlineButton}"
                  controls:Icon.Glyph="{StaticResource Icon.ChevronRight}" />
        </Grid>

        <!-- 1280x720 is the size the view model composes at; the Viewbox only scales what came back, so
             nothing is resampled twice. -->
        <Viewbox Grid.Row="1" Margin="16" Stretch="Uniform">
          <Border Width="1280" Height="720" Background="{StaticResource BgBrush}">
            <!-- Spec 6.2: dragging the picture that is laid across the platforms. The Image is the composed
                 stage at its own 1280 by 720, so the code behind only has to undo the Viewbox's scale. -->
            <Image MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                   MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                   MouseMove="Preview_MouseMove"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding Preview}"
                   Stretch="Fill">
              <Image.Style>
                <Style TargetType="Image">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CanPan}" Value="True">
                      <Setter Property="Cursor" Value="SizeAll" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
          </Border>
        </Viewbox>

        <!-- Spec 3.1: top left inside the card, on the image's own 16 px margin. A ListBox rather than two
             ToggleButtons, so the list owns which chip is on; ChipRow draws each item with ChipToggle and carries
             the focus ring. A map with no platform art has no preview, so the chips go with it. -->
        <ListBox Grid.Row="1"
                 Margin="16,16,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource ChipRow}"
                 Visibility="{Binding Preview, Converter={StaticResource NullToVis}}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem AutomationProperties.Name="All pieces"
                       Content="All pieces"
                       IsSelected="{Binding ShowAllPieces, Mode=TwoWay}" />
          <ListBoxItem AutomationProperties.Name="Selected only"
                       Content="Selected only"
                       IsSelected="{Binding IsolatePreview, Mode=TwoWay}" />
        </ListBox>

        <!-- Spec 3.2: Selected only with nothing selected. The view model returns null when there is nothing to say,
             so the NullToVis the empty text already uses hides the line. -->
        <Border Grid.Row="1"
                Margin="16"
                Padding="12,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{StaticResource Surface2Brush}"
                CornerRadius="{StaticResource Radius}"
                Visibility="{Binding IsolateHint, Converter={StaticResource NullToVis}}">
          <TextBlock Foreground="{StaticResource Text2Brush}" Text="{Binding IsolateHint}" />
        </Border>

        <!-- Spec 14: a map with no platform art of its own has nothing to compose and nothing to save. -->
        <TextBlock Grid.Row="1"
                   MaxWidth="420"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Text3Brush}"
                   Text="{Binding EmptyText}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="{Binding Preview, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />
      </Grid>
    </Border>

    <Border Grid.Row="0"
            Grid.Column="1"
            Width="{StaticResource PanelWidth}"
            Margin="20,0,0,0"
            Padding="18,0,18,18"
            Style="{StaticResource CardBorder}">
      <!-- The panel is taller than the window's minimum height once every block is open, so it scrolls. The
           theme's scrollbar is drawn over the content rather than beside it, so the content keeps clear of it. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Source" />
          <TextBlock Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />

          <!-- Spec 5.3: where the values on the sliders came from, with the way back to a clean start beside it. -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasValuesFrom, Converter={StaticResource BoolToVis}}">
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource HintText}"
                       Text="{Binding ValuesFromText}" />
            <Button Margin="6,6,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start fresh"
                    Command="{Binding StartFreshCommand}"
                    Content="Start fresh"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource ResetLink}" />
          </StackPanel>

          <!-- The header counts the ticked rows, so All and None belong on its line rather than under the list. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding FilesHeader}" />
            <StackPanel Grid.Column="1" Margin="0,18,0,6" Orientation="Horizontal">
              <Button Command="{Binding AllCommand}"
                      Content="All"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      Style="{StaticResource ResetLink}" />
              <Button Margin="10,0,0,0"
                      Command="{Binding NoneCommand}"
                      Content="None"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
          </Grid>

          <!-- Ruling 10: CardTick is a bare 18 x 18 box with no content of its own, so the tick takes its own
               column beside the thumbnail and the name, and carries the file name for the screen reader. -->
          <ItemsControl ItemsSource="{Binding Pieces}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PlatformPieceViewModel}">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding FileName}"
                            FocusVisualStyle="{StaticResource DialogFocusRing}"
                            IsChecked="{Binding IsTicked}"
                            Style="{StaticResource CardTick}" />

                  <!-- Spec 3.3: the thumbnail and the name are one click target. Background Transparent, not
                       unset: a Border with no Background is not hit testable. The Ctrl gesture is listed first so
                       it is matched before the plain click. -->
                  <Border Grid.Column="1"
                          Grid.ColumnSpan="3"
                          Padding="4,3"
                          AutomationProperties.Name="{Binding FileName}"
                          CornerRadius="{StaticResource Radius}"
                          Focusable="True"
                          FocusVisualStyle="{StaticResource DialogFocusRing}"
                          ToolTip="{Binding RelativePath}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.InputBindings>
                      <MouseBinding Command="{Binding DataContext.AddTickCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}"
                                    Gesture="Ctrl+LeftClick" />
                      <MouseBinding Command="{Binding DataContext.SoloCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}"
                                    MouseAction="LeftClick" />
                      <KeyBinding Key="Enter"
                                  Command="{Binding DataContext.SoloCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                  CommandParameter="{Binding}" />
                      <KeyBinding Key="Space"
                                  Command="{Binding DataContext.SoloCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                  CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Border Width="48"
                              Height="27"
                              VerticalAlignment="Center"
                              Style="{StaticResource PictureTile}">
                        <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                      </Border>

                      <TextBlock Grid.Column="1"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MonoText}"
                                 Text="{Binding FileName}"
                                 TextTrimming="CharacterEllipsis" />

                      <TextBlock Grid.Column="2"
                                 Margin="10,0,0,0"
                                 Style="{StaticResource Readout}"
                                 Text="{Binding Readout}" />

                      <TextBlock Grid.Row="1"
                                 Grid.ColumnSpan="3"
                                 Style="{StaticResource RowNote}"
                                 Text="{Binding Note}" />
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Margin="0,18,0,6" Orientation="Horizontal">
            <TextBlock Margin="0" Style="{StaticResource FieldLabel}" Text="Image" />
            <Button AutomationProperties.Name="Reset image"
                    Command="{Binding ResetImageCommand}"
                    Content="Reset"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource ResetLink}" />
          </StackPanel>
          <!-- Two lines rather than one with a style trigger: with nothing ticked the text is a hint, and with a
               file ticked it is the value the Source line above reads in. -->
          <TextBlock Style="{StaticResource HintText}"
                     Text="{Binding ImageText}"
                     Visibility="{Binding ImageHintVisible, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding ImageText}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding CanUseImage, Converter={StaticResource BoolToVis}}" />
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <Button Padding="10,4"
                    Command="{Binding ReplaceCommand}"
                    Content="Replace"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PlainButton}" />
            <Button Margin="8,0,0,0"
                    Padding="10,4"
                    Command="{Binding EditOutsideCommand}"
                    Content="Edit in another app"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    IsEnabled="{Binding CanEditOutside}"
                    Style="{StaticResource PlainButton}" />
          </StackPanel>
          <!-- Spec 6.2: one picture laid over the whole stage and cut for each piece, or the same picture fitted
               to every piece on its own. A radio group rather than two chips, because it is one question. -->
          <StackPanel Margin="0,8,0,0" IsEnabled="{Binding CanUseFit}" Orientation="Horizontal">
            <RadioButton AutomationProperties.Name="Across the platforms"
                         Content="Across the platforms"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         GroupName="Fit"
                         IsChecked="{Binding FitAcross, Mode=TwoWay}"
                         Style="{StaticResource ChipToggle}" />
            <RadioButton Margin="8,0,0,0"
                         AutomationProperties.Name="On each piece"
                         Content="On each piece"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         GroupName="Fit"
                         IsChecked="{Binding FitAcross, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                         Style="{StaticResource ChipToggle}" />
          </StackPanel>
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ImageError}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity" />
              <Button Margin="0,18,0,6"
                      Command="{Binding ResetOpacityCommand}"
                      Content="Reset"
                      IsEnabled="{Binding CanAdjust}"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
            <Slider Grid.Row="1"
                    AutomationProperties.Name="Opacity"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    IsEnabled="{Binding CanAdjust}"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    Style="{StaticResource EditorSlider}"
                    Thumb.DragCompleted="Slider_DragCompleted"
                    Value="{Binding Opacity}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Style="{StaticResource Readout}"
                       Text="{Binding OpacityText}" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Hue" />
              <Button Margin="0,18,0,6"
                      Command="{Binding ResetHueCommand}"
                      Content="Reset"
                      IsEnabled="{Binding CanAdjust}"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
            <Slider Grid.Row="1"
                    AutomationProperties.Name="Hue"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    IsEnabled="{Binding CanAdjust}"
                    LargeChange="15"
                    Maximum="180"
                    Minimum="-180"
                    SmallChange="1"
                    Style="{StaticResource EditorSlider}"
                    Thumb.DragCompleted="Slider_DragCompleted"
                    Value="{Binding Hue}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Style="{StaticResource Readout}"
                       Text="{Binding HueText}" />
          </Grid>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Save into pack" />
          <ComboBox AutomationProperties.Name="Save into pack"
                    ItemsSource="{Binding PackChoices}"
                    SelectedItem="{Binding TargetPack}" />
          <TextBox Margin="0,8,0,0"
                   AutomationProperties.Name="New pack name"
                   Style="{StaticResource FieldTextBox}"
                   Text="{Binding NewPackName, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsNewPack, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PackNameError}" />

          <TextBlock Margin="0,18,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <CheckBox VerticalAlignment="Center"
                Content="Apply to game"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsChecked="{Binding ApplyNow}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <!-- Spec 9: one Save writes every map of the set, so the line says which map it is on and the Cancel
             beside it stops the run between maps. The maps already written stay in the pack. -->
        <TextBlock Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource HintText}"
                   Text="{Binding SaveProgressText}"
                   Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}" />
        <Button Margin="0,0,8,0"
                AutomationProperties.Name="Cancel save"
                Command="{Binding CancelSaveCommand}"
                Content="Cancel"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                Style="{StaticResource PlainButton}"
                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}" />
        <!-- No command: IsCancel closes with false, so the shell skips the rescan. Escape does the same. A save
             part way through a set of maps must not be closed out from under, so it holds this one. -->
        <Button Margin="0,0,8,0"
                Content="Cancel"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsCancel="True"
                IsEnabled="{Binding CanCloseWindow}"
                Style="{StaticResource PlainButton}" />
        <Button Command="{Binding SaveCommand}"
                Content="Save"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsDefault="True"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

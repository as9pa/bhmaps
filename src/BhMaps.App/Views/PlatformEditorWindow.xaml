<Window x:Class="BhMaps.App.Views.PlatformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BhMaps.App.Converters"
        xmlns:vm="clr-namespace:BhMaps.App.ViewModels"
        Title="{Binding Title}" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- One label style carries the whole panel's vertical rhythm, so a block is a label and its control. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <!-- Its own Text drives the visibility, so a valid name takes the line back rather than leaving a gap. -->
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The Reset in a slider's label: a word, not a button, so the label reads as one line. -->
    <Style x:Key="ResetLink" TargetType="Button" BasedOn="{StaticResource PlainButton}">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <Style x:Key="Readout" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <!-- Cells rather than docking, so the order the eye reads is the order Tab walks: a DockPanel would have to
       declare the bottom button row before the panel whose values it saves. -->
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
      <Grid>
        <!-- 1280x720 is the size the view model composes at; the Viewbox only scales what came back, so
             nothing is resampled twice. -->
        <Viewbox Margin="16" Stretch="Uniform">
          <Border Width="1280" Height="720" Background="{StaticResource BgBrush}">
            <Image RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding Preview}"
                   Stretch="Fill" />
          </Border>
        </Viewbox>

        <!-- Spec 14: a map with no platform art of its own has nothing to compose and nothing to save. -->
        <TextBlock MaxWidth="420"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Text3Brush}"
                   Text="{Binding EmptyText}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="{Binding Preview, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />
      </Grid>
    </Border>

    <Border Grid.Row="0"
            Grid.Column="1"
            Width="{StaticResource PanelWidth}"
            Margin="20,0,0,0"
            Padding="18,0,18,18"
            Style="{StaticResource CardBorder}">
      <!-- The panel is taller than the window's minimum height once every block is open, so it scrolls. The
           theme's scrollbar is drawn over the content rather than beside it, so the content keeps clear of it. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Source" />
          <TextBlock Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />

          <!-- The header counts the ticked rows, so All and None belong on its line rather than under the list. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding FilesHeader}" />
            <StackPanel Grid.Column="1" Margin="0,18,0,6" Orientation="Horizontal">
              <Button Command="{Binding AllCommand}"
                      Content="All"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      Style="{StaticResource ResetLink}" />
              <Button Margin="10,0,0,0"
                      Command="{Binding NoneCommand}"
                      Content="None"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
          </Grid>

          <!-- Ruling 10: CardTick is a bare 18 x 18 box with no content of its own, so the tick takes its own
               column beside the thumbnail and the name, and carries the file name for the screen reader. -->
          <ItemsControl ItemsSource="{Binding Pieces}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PlatformPieceViewModel}">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding FileName}"
                            FocusVisualStyle="{StaticResource DialogFocusRing}"
                            IsChecked="{Binding IsTicked}"
                            Style="{StaticResource CardTick}" />

                  <Border Grid.Column="1"
                          Width="48"
                          Height="27"
                          VerticalAlignment="Center"
                          Style="{StaticResource PictureTile}">
                    <Border CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                  </Border>

                  <TextBlock Grid.Column="2"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource MonoText}"
                             Text="{Binding FileName}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding RelativePath}" />

                  <TextBlock Grid.Column="3"
                             Margin="10,0,0,0"
                             Style="{StaticResource Readout}"
                             Text="{Binding Readout}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Margin="0,18,0,6" Orientation="Horizontal">
            <TextBlock Margin="0" Style="{StaticResource FieldLabel}" Text="Image" />
            <Button AutomationProperties.Name="Reset image"
                    Command="{Binding ResetImageCommand}"
                    Content="Reset"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource ResetLink}" />
          </StackPanel>
          <!-- Two lines rather than one with a style trigger: with nothing ticked the text is a hint, and with a
               file ticked it is the value the Source line above reads in. -->
          <TextBlock Style="{StaticResource HintText}"
                     Text="{Binding ImageText}"
                     Visibility="{Binding ImageHintVisible, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding ImageText}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding CanUseImage, Converter={StaticResource BoolToVis}}" />
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <Button Padding="10,4"
                    Command="{Binding ReplaceCommand}"
                    Content="Replace"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource PlainButton}" />
            <Button Margin="8,0,0,0"
                    Padding="10,4"
                    Content="Edit in another app"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    IsEnabled="{Binding CanEditOutside}"
                    Style="{StaticResource PlainButton}" />
          </StackPanel>
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ImageError}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity" />
              <Button Margin="0,18,0,6"
                      Command="{Binding ResetOpacityCommand}"
                      Content="Reset"
                      IsEnabled="{Binding CanAdjust}"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
            <Slider Grid.Row="1"
                    AutomationProperties.Name="Opacity"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    IsEnabled="{Binding CanAdjust}"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    Style="{StaticResource EditorSlider}"
                    Thumb.DragCompleted="Slider_DragCompleted"
                    Value="{Binding Opacity}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Style="{StaticResource Readout}"
                       Text="{Binding OpacityText}" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Hue" />
              <Button Margin="0,18,0,6"
                      Command="{Binding ResetHueCommand}"
                      Content="Reset"
                      IsEnabled="{Binding CanAdjust}"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
            <Slider Grid.Row="1"
                    AutomationProperties.Name="Hue"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    IsEnabled="{Binding CanAdjust}"
                    LargeChange="15"
                    Maximum="180"
                    Minimum="-180"
                    SmallChange="1"
                    Style="{StaticResource EditorSlider}"
                    Thumb.DragCompleted="Slider_DragCompleted"
                    Value="{Binding Hue}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Style="{StaticResource Readout}"
                       Text="{Binding HueText}" />
          </Grid>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Save into pack" />
          <ComboBox AutomationProperties.Name="Save into pack"
                    ItemsSource="{Binding PackChoices}"
                    SelectedItem="{Binding TargetPack}" />
          <TextBox Margin="0,8,0,0"
                   AutomationProperties.Name="New pack name"
                   Style="{StaticResource FieldTextBox}"
                   Text="{Binding NewPackName, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsNewPack, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PackNameError}" />

          <TextBlock Margin="0,18,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <CheckBox VerticalAlignment="Center"
                Content="Apply to game now"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsChecked="{Binding ApplyNow}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <!-- No command: IsCancel closes with false, so the shell skips the rescan. Escape does the same. -->
        <Button Margin="0,0,8,0"
                Content="Cancel"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsCancel="True"
                Style="{StaticResource PlainButton}" />
        <Button Command="{Binding SaveCommand}"
                Content="Save"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsDefault="True"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

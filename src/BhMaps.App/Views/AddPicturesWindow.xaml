<Window x:Class="BhMaps.App.Views.AddPicturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
        xmlns:converters="clr-namespace:BhMaps.App.Converters"
        Title="Add Custom Image" Width="900" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Background="{StaticResource BgBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- One label style carries the whole panel's vertical rhythm, so a block is a label and its control. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <!-- Its own Text drives the visibility, so a valid pack name takes the line back rather than leaving a gap. -->
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Four short labels in a row, so they size to their content rather than to the theme radio's 120 px form
         column; the WrapPanel takes a second line if the window is narrowed instead of clipping the last one. -->
    <!-- BasedOn the implicit style, or these four fall off the Fluent theme (ThemeMode=Dark) onto the legacy
         template, where the chosen radio draws as a hollow ring and the rest as filled discs. -->
    <Style x:Key="FitRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0,0,18,6" />
      <Setter Property="GroupName" Value="Fit" />
    </Style>

    <!-- A row is a file name and its Remove button, not a choice, so the container leaves the tab order and Tab
         lands on the button inside it instead. -->
    <Style x:Key="PictureRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileListBoxItem}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,4" />
      <!-- Without this a screen reader reads the row's view model type name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
    </Style>
  </Window.Resources>

  <!-- Cells rather than docking, so the order the eye reads is the order Tab walks: a DockPanel would have to
       declare the bottom button row before the lists and the panel it acts on. -->
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- AllowDrop on the zone as well as on the window: the window's preview handlers take every drop, and this
         says the boxed area really is a target rather than only looking like one. -->
    <Border Grid.Row="0"
            Grid.Column="0"
            Height="104"
            AllowDrop="True"
            Style="{StaticResource CardBorder}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center"
                   Style="{StaticResource HintText}"
                   Text="Drop pictures anywhere on this window." />
        <Button Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Command="{Binding PickFilesCommand}"
                Content="Pick files"
                controls:Icon.Glyph="{StaticResource Icon.Plus}"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                Style="{StaticResource OutlineButton}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" Style="{StaticResource CardBorder}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Margin="14,10,14,8"
                   Style="{StaticResource SectionHeaderText}"
                   Text="{Binding Files.Count, StringFormat='Pictures, {0}'}" />
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}" />

        <Grid>
          <!-- Focusable="False" plus Continue: the list is never an invisible tab stop of its own, and Tab walks
               straight through the Remove buttons inside the realized rows. -->
          <ListBox Margin="6"
                   AutomationProperties.Name="Pictures to add"
                   Focusable="False"
                   ItemContainerStyle="{StaticResource PictureRowItem}"
                   ItemsSource="{Binding Files}"
                   KeyboardNavigation.TabNavigation="Continue"
                   Style="{StaticResource TileListBox}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <!-- Named after its file, so one Remove is told from the one above it by ear too. -->
                  <Button DockPanel.Dock="Right"
                          Margin="8,0,0,0"
                          AutomationProperties.Name="{Binding FileName, StringFormat='Remove {0}'}"
                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Content="Remove"
                          FocusVisualStyle="{StaticResource DialogFocusRing}"
                          Style="{StaticResource PlainButton}" />
                  <TextBlock VerticalAlignment="Center"
                             Text="{Binding FileName}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding FullPath}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty is its own state (spec 7.8); the list has no other way to say there is nothing in it yet. -->
          <TextBlock Margin="14,14,14,0"
                     VerticalAlignment="Top"
                     Text="No pictures yet. Drop them here or pick files.">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Files.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>

    <Border Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="{StaticResource PanelWidth}"
            Margin="20,0,0,0"
            Padding="18,0,18,18"
            Style="{StaticResource CardBorder}">
      <!-- The panel is taller than the window's minimum height once the new-pack field is out, so it scrolls. The
           theme's scrollbar is drawn over the content rather than beside it, so the content keeps clear of it. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Preview of the first picture" />
          <Border Width="320"
                  Height="180"
                  HorizontalAlignment="Left"
                  Background="{StaticResource BgBrush}"
                  CornerRadius="{StaticResource Radius}">
            <Grid>
              <!-- 320x180 is what the view model renders, so nothing here is resampled a second time. -->
              <Image Source="{Binding Preview}" Stretch="Fill" />
              <TextBlock Margin="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Style="{StaticResource HintText}"
                         Text="No preview yet. Add a picture."
                         TextAlignment="Center"
                         Visibility="{Binding Preview, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />
            </Grid>
          </Border>
          <!-- Under the preview, not at the foot of the panel: this line says why there is no preview, and at the
               foot it is the first thing a shorter window scrolls out of sight. -->
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Fit" />
          <!-- The ring is a local value, not a setter in FitRadio: through a Style the theme's own focus visual
               wins and the radios keep the stock dashed rectangle, which is close to invisible on this palette. -->
          <WrapPanel>
            <RadioButton Content="Stretch"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         IsChecked="{Binding FitStretch}"
                         Style="{StaticResource FitRadio}" />
            <RadioButton Content="Center"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         IsChecked="{Binding FitCenter}"
                         Style="{StaticResource FitRadio}" />
            <RadioButton Content="Fill"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         IsChecked="{Binding FitFill}"
                         Style="{StaticResource FitRadio}" />
            <RadioButton Content="Fit"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         IsChecked="{Binding FitFit}"
                         Style="{StaticResource FitRadio}" />
          </WrapPanel>
          <TextBlock Margin="0,4,0,0"
                     Style="{StaticResource HintText}"
                     Text="Every picture becomes a 2048x1151 JPEG in the pack. The files you picked are not changed." />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Import into pack" />
          <ComboBox AutomationProperties.Name="Import into pack"
                    ItemsSource="{Binding PackChoices}"
                    SelectedItem="{Binding TargetPack}" />
          <TextBox Margin="0,8,0,0"
                   AutomationProperties.Name="New pack name"
                   Style="{StaticResource FieldTextBox}"
                   Text="{Binding NewPackName, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsNewPack, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PackNameError}" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Then" />
          <RadioButton Content="Add to the library"
                       FocusVisualStyle="{StaticResource DialogFocusRing}"
                       GroupName="Then"
                       IsChecked="{Binding ThenLibrary}" />
          <RadioButton Margin="0,6,0,0"
                       Content="{Binding MapChoiceText}"
                       FocusVisualStyle="{StaticResource DialogFocusRing}"
                       GroupName="Then"
                       IsChecked="{Binding ThenMap}"
                       Visibility="{Binding ShowMapChoice, Converter={StaticResource BoolToVis}}" />
          <RadioButton Margin="0,6,0,0"
                       Content="{Binding TickedChoiceText}"
                       FocusVisualStyle="{StaticResource DialogFocusRing}"
                       GroupName="Then"
                       IsChecked="{Binding ThenTicked}"
                       Visibility="{Binding ShowTickedChoice, Converter={StaticResource BoolToVis}}" />
          <RadioButton Margin="0,6,0,0"
                       Content="{Binding AllChoiceText}"
                       FocusVisualStyle="{StaticResource DialogFocusRing}"
                       GroupName="Then"
                       IsChecked="{Binding ThenAll}" />
          <TextBlock Margin="0,8,0,0"
                     Style="{StaticResource HintText}"
                     Text="The pictures go to the maps in order, repeating from the first when there are more maps than pictures." />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <!-- No command: IsCancel closes with false, so the shell imports nothing. Escape does the same. -->
      <Button Margin="0,0,8,0"
              Content="Cancel"
              FocusVisualStyle="{StaticResource DialogFocusRing}"
              IsCancel="True"
              Style="{StaticResource PlainButton}" />
      <Button Command="{Binding AddCommand}"
              Content="Add"
              FocusVisualStyle="{StaticResource DialogFocusRing}"
              IsDefault="True"
              Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="BhMaps.App.Views.BackgroundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BhMaps.App.Views.Controls"
        xmlns:converters="clr-namespace:BhMaps.App.Converters"
        xmlns:vm="clr-namespace:BhMaps.App.ViewModels"
        Title="{Binding Title}" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Style="{StaticResource ChromeWindow}"
        Background="{StaticResource BgBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- One label style carries the whole panel's vertical rhythm, so a block is a label and its control. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
      <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- 3.6 E4: the picture sliders sit closer together than the fields above them, so the pack box stays on
         screen at the window's 720 px height without scrolling. -->
    <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <!-- Its own Text drives the visibility, so a valid slot takes the line back rather than leaving a gap. -->
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MissingFgBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The Reset in a slider's label: a word, not a button, so the label reads as one line. -->
    <Style x:Key="ResetLink" TargetType="Button" BasedOn="{StaticResource PlainButton}">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

    <!-- Pan applies in Fill only; in the other two modes the whole row sits at 45% (spec 7.2). -->
    <Style x:Key="PanRow" TargetType="Grid">
      <Setter Property="Opacity" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFill}" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Readout" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <!-- Cells rather than docking, so the order the eye reads is the order Tab walks: a DockPanel would have to
       declare the bottom button row before the panel whose values it saves. -->
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 3.9: the frame hugs the picture at 16:9 and is centred vertically beside the panel, with the size caption
         under it, rather than filling the tall column. -->
    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
    <Border Style="{StaticResource CardBorder}">
      <Grid>
        <!-- 640x360 is the card preview of spec 7.1 and the size the view model renders; the Viewbox only
             scales what came back, so nothing is resampled twice. -->
        <Viewbox Margin="8" Stretch="Uniform">
          <Border Width="640" Height="360" Background="{StaticResource BgBrush}">
            <Image RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding Preview}"
                   Stretch="Fill" />
          </Border>
        </Viewbox>

        <!-- Spec 7.2: nothing chosen yet, or a source that has gone since the scan. Browse is in line with it,
             because with no picture there is nothing else on this half of the window to act on. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding Preview, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
          <TextBlock MaxWidth="420"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource Text3Brush}"
                     Text="{Binding EmptyText}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Margin="0,12,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding ReplaceCommand}"
                  Content="Browse"
                  FocusVisualStyle="{StaticResource DialogFocusRing}"
                  Style="{StaticResource OutlineButton}" />
        </StackPanel>

      </Grid>
    </Border>
    <TextBlock Margin="0,8,0,0"
               HorizontalAlignment="Right"
               FontSize="{StaticResource FontCaption}"
               Foreground="{StaticResource Text3Brush}"
               Text="{x:Static vm:BackgroundEditorViewModel.PreviewSizeText}" />
    </StackPanel>

    <Border Grid.Row="0"
            Grid.Column="1"
            Width="{StaticResource PanelWidth}"
            Margin="20,0,0,0"
            Padding="18,0,18,18"
            Style="{StaticResource CardBorder}">
      <!-- The panel is taller than the window's minimum height once every block is open, so it scrolls. The
           theme's scrollbar is drawn over the content rather than beside it, so the content keeps clear of it. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Source" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="96"
                    Height="54"
                    Background="{StaticResource TileBrush}"
                    CornerRadius="{StaticResource Radius}">
              <Border CornerRadius="{StaticResource Radius}">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding SourceThumbnail}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource HintText}" Text="{Binding SourceDetail}" />
            </StackPanel>
            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding ReplaceCommand}"
                    Content="Replace"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource OutlineButton}" />
          </Grid>
          <TextBlock Style="{StaticResource HintText}" Text="Or drop an image anywhere on this window." />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Map" />
          <ComboBox AutomationProperties.Name="Map"
                    DisplayMemberPath="DisplayNames"
                    IsEnabled="{Binding HasMaps}"
                    ItemsSource="{Binding Maps}"
                    SelectedItem="{Binding SelectedMap}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding MapLabel}" />
          <!-- 3.2: one background under every layout of a map, said quietly when the map has more than one. -->
          <TextBlock Style="{StaticResource HintText}"
                     Text="{Binding SelectedMap.SharedNote, FallbackValue=''}"
                     TextWrapping="Wrap"
                     Visibility="{Binding SelectedMap.HasSharedNote, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

          <!-- Spec 8: where the values on this panel came from, with the way back to a clean start beside it. -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasValuesFrom, Converter={StaticResource BoolToVis}}">
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource HintText}"
                       Text="{Binding ValuesFromText}"
                       TextTrimming="CharacterEllipsis" />
            <Button Margin="8,8,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start fresh"
                    Command="{Binding StartFreshCommand}"
                    Content="Start fresh"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    Style="{StaticResource ResetLink}" />
          </StackPanel>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Fit" />
          <!-- MinWidth 0: the theme's radio button reserves 120 px for a form column, and three of those do not
               fit the 360 px panel. Here they are a row of three short labels, so they size to their content. -->
          <StackPanel Orientation="Horizontal">
            <RadioButton MinWidth="0"
                         Margin="0,0,20,0"
                         Content="Fill"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         GroupName="Fit"
                         IsChecked="{Binding FitFill}" />
            <RadioButton MinWidth="0"
                         Margin="0,0,20,0"
                         Content="Fit"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         GroupName="Fit"
                         IsChecked="{Binding FitFit}" />
            <RadioButton MinWidth="0"
                         Margin="0,0,20,0"
                         Content="Center"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         GroupName="Fit"
                         IsChecked="{Binding FitCenter}" />
            <RadioButton MinWidth="0"
                         Content="Stretch"
                         FocusVisualStyle="{StaticResource DialogFocusRing}"
                         GroupName="Fit"
                         IsChecked="{Binding FitStretch}" />
          </StackPanel>

          <!-- 3.6 E4: two 172 px columns with a gap, which is the panel's width once its padding is taken off. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="172" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="172" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource PanRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Pan X" />
                <Button Margin="0,8,0,4"
                        Command="{Binding ResetPanXCommand}"
                        Content="Reset"
                        Style="{StaticResource ResetLink}" />
              </StackPanel>
              <Slider Grid.Row="1"
                      AutomationProperties.Name="Pan X"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      IsEnabled="{Binding IsFill}"
                      LargeChange="0.1"
                      Maximum="1"
                      Minimum="0"
                      SmallChange="0.01"
                      Style="{StaticResource EditorSlider}"
                      Thumb.DragCompleted="Slider_DragCompleted"
                      Value="{Binding PanX}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource Readout}"
                         Text="{Binding PanX, StringFormat=N2}" />
            </Grid>

            <Grid Grid.Column="2" Style="{StaticResource PanRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Pan Y" />
                <Button Margin="0,8,0,4"
                        Command="{Binding ResetPanYCommand}"
                        Content="Reset"
                        Style="{StaticResource ResetLink}" />
              </StackPanel>
              <Slider Grid.Row="1"
                      AutomationProperties.Name="Pan Y"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      IsEnabled="{Binding IsFill}"
                      LargeChange="0.1"
                      Maximum="1"
                      Minimum="0"
                      SmallChange="0.01"
                      Style="{StaticResource EditorSlider}"
                      Thumb.DragCompleted="Slider_DragCompleted"
                      Value="{Binding PanY}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource Readout}"
                         Text="{Binding PanY, StringFormat=N2}" />
            </Grid>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Hue" />
                <Button Margin="0,8,0,4"
                        Command="{Binding ResetHueCommand}"
                        Content="Reset"
                        Style="{StaticResource ResetLink}" />
              </StackPanel>
              <Slider Grid.Row="1"
                      AutomationProperties.Name="Hue"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      LargeChange="15"
                      Maximum="180"
                      Minimum="-180"
                      SmallChange="1"
                      Style="{StaticResource EditorSlider}"
                      Thumb.DragCompleted="Slider_DragCompleted"
                      Value="{Binding Hue}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource Readout}"
                         Text="{Binding HueText}" />
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Saturation" />
                <Button Margin="0,8,0,4"
                        Command="{Binding ResetSaturationCommand}"
                        Content="Reset"
                        Style="{StaticResource ResetLink}" />
              </StackPanel>
              <Slider Grid.Row="1"
                      AutomationProperties.Name="Saturation"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      LargeChange="10"
                      Maximum="100"
                      Minimum="-100"
                      SmallChange="1"
                      Style="{StaticResource EditorSlider}"
                      Thumb.DragCompleted="Slider_DragCompleted"
                      Value="{Binding SaturationPercent}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource Readout}"
                         Text="{Binding SaturationPercent, StringFormat=F0}" />
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Contrast" />
                <Button Margin="0,8,0,4"
                        Command="{Binding ResetContrastCommand}"
                        Content="Reset"
                        Style="{StaticResource ResetLink}" />
              </StackPanel>
              <Slider Grid.Row="1"
                      AutomationProperties.Name="Contrast"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      LargeChange="10"
                      Maximum="100"
                      Minimum="-100"
                      SmallChange="1"
                      Style="{StaticResource EditorSlider}"
                      Thumb.DragCompleted="Slider_DragCompleted"
                      Value="{Binding ContrastPercent}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource Readout}"
                         Text="{Binding ContrastPercent, StringFormat=F0}" />
            </Grid>

            <Grid Grid.Row="2" Grid.Column="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Darken" />
                <Button Margin="0,8,0,4"
                        Command="{Binding ResetDarkenCommand}"
                        Content="Reset"
                        Style="{StaticResource ResetLink}" />
              </StackPanel>
              <Slider Grid.Row="1"
                      AutomationProperties.Name="Darken"
                      FocusVisualStyle="{StaticResource DialogFocusRing}"
                      LargeChange="10"
                      Maximum="100"
                      Minimum="0"
                      SmallChange="1"
                      Style="{StaticResource EditorSlider}"
                      Thumb.DragCompleted="Slider_DragCompleted"
                      Value="{Binding DarkenPercent}" />
              <!-- The unit is a TextBlock of its own, so the readout's format string has no percent sign to escape. -->
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Readout}" Text="{Binding DarkenPercent, StringFormat=F0}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource MonoText}" Text="%" />
              </StackPanel>
            </Grid>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource SliderLabel}" Text="Blur" />
              <Button Margin="0,8,0,4"
                      Command="{Binding ResetBlurCommand}"
                      Content="Reset"
                      Style="{StaticResource ResetLink}" />
            </StackPanel>
            <Slider Grid.Row="1"
                    AutomationProperties.Name="Blur"
                    FocusVisualStyle="{StaticResource DialogFocusRing}"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    Style="{StaticResource EditorSlider}"
                    Thumb.DragCompleted="Slider_DragCompleted"
                    Value="{Binding BlurPercent}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       Style="{StaticResource Readout}"
                       Text="{Binding BlurPercent, StringFormat=F0}" />
          </Grid>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Save into pack" />
          <!-- 3.6 E3: one editable box. The list picks a pack, typing names a new one, and the hint or the
               error sits right under it so neither can fall below the window. -->
          <ComboBox AutomationProperties.Name="Save into pack"
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding PackChoices}"
                    Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,8,0,0"
                     Style="{StaticResource HintText}"
                     Text="{Binding PackNameHint}"
                     Visibility="{Binding PackNameHint, Converter={StaticResource NullToVis}}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PackNameError}" />
          <TextBlock Style="{StaticResource HintText}" Text="{Binding OverwriteHint}" />

          <TextBlock Margin="0,16,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
      <!-- 3.0 E: the two saves in place of one Save and an "Apply to game" tick, in the order every dialog uses:
           Cancel, then the quieter save, then the primary at the end. Enter takes the primary, which is the one
           that puts the picture in the game; Escape closes with false, so the shell skips the rescan. -->
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <!-- No command: IsCancel closes with false. -->
        <Button Margin="0,0,8,0"
                Content="Cancel"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsCancel="True"
                Style="{StaticResource PlainButton}" />
        <!-- 3.6 E1: asks for its own pack name, so a bad name in the box does not hold it. -->
        <Button Margin="0,0,8,0"
                Command="{Binding AddAsNewCommand}"
                Content="Add as new"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                Style="{StaticResource OutlineButton}"
                ToolTip="Save a copy under a new name, into any pack." />
        <Button Margin="0,0,8,0"
                Command="{Binding SaveOnlyCommand}"
                Content="Save only"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                Style="{StaticResource OutlineButton}" />
        <Button AutomationProperties.Name="{Binding SaveAndApplyText}"
                Command="{Binding SaveAndApplyCommand}"
                Content="{Binding SaveAndApplyText}"
                FocusVisualStyle="{StaticResource DialogFocusRing}"
                IsDefault="True"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

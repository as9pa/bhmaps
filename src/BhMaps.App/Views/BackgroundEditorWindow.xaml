<Window x:Class="BhMaps.App.Views.BackgroundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background editor" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <CheckBox Content="Apply to game now" IsChecked="{Binding ApplyNow}" VerticalAlignment="Center" Margin="0,0,16,0" />
      <Button Content="Save" Command="{Binding SaveCommand}" Width="100" Margin="0,0,6,0" />
      <Button Content="Cancel" Width="100" IsCancel="True" />
    </StackPanel>
    <Border DockPanel.Dock="Right" Width="320" Padding="12,0,0,0">
      <StackPanel>
        <TextBlock Text="Slot (file name inside Backgrounds)" FontWeight="SemiBold" />
        <ComboBox IsEditable="True" ItemsSource="{Binding Slots}" Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,2" />
        <TextBlock Text="{Binding SlotError}" Foreground="#C62828" FontSize="11" Margin="0,0,0,10" />

        <TextBlock Text="Source image" FontWeight="SemiBold" />
        <DockPanel Margin="0,4,0,2">
          <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Padding="10,2" Margin="6,0,0,0" />
          <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="3" />
        </DockPanel>
        <TextBlock Text="Or drop an image anywhere on this window." Foreground="#888888" FontSize="11" Margin="0,0,0,10" />

        <TextBlock Text="Fit" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
          <RadioButton Content="Cover" IsChecked="{Binding ModeCover}" Margin="0,0,10,0" />
          <RadioButton Content="Contain" IsChecked="{Binding ModeContain}" Margin="0,0,10,0" />
          <RadioButton Content="Stretch" IsChecked="{Binding ModeStretch}" />
        </StackPanel>

        <TextBlock Text="Pan X (Cover only)" />
        <Slider Minimum="0" Maximum="1" Value="{Binding PanX}" IsEnabled="{Binding IsCover}" Margin="0,2,0,6" />
        <TextBlock Text="Pan Y (Cover only)" />
        <Slider Minimum="0" Maximum="1" Value="{Binding PanY}" IsEnabled="{Binding IsCover}" Margin="0,2,0,6" />
        <TextBlock Text="{Binding DarkenPercent, StringFormat='Darken {0:0}%'}" />
        <Slider Minimum="0" Maximum="100" Value="{Binding DarkenPercent}" Margin="0,2,0,10" />

        <TextBlock Text="Save into pack" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding PackChoices}" SelectedItem="{Binding TargetPack}" Margin="0,4,0,4" />
        <TextBox Text="{Binding NewPackName, UpdateSourceTrigger=PropertyChanged}" Padding="3"
                 Visibility="{Binding IsNewPack, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
    <Border Background="#1E1E1E" CornerRadius="4">
      <Viewbox Stretch="Uniform" Margin="8">
        <Border Width="640" Height="360" Background="Black">
          <Image Source="{Binding Preview}" Stretch="Fill" />
        </Border>
      </Viewbox>
    </Border>
  </DockPanel>
</Window>

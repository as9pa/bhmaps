<UserControl x:Class="BhMaps.App.Views.FolderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Left" Content="&#x25C0; Back" Command="{Binding BackCommand}" Padding="10,4" Margin="0,0,10,0" />
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <ListView ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Background" Value="White" />
          <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4">
            <Border DockPanel.Dock="Left" Width="120" Height="68" Background="#1E1E1E" CornerRadius="3" Margin="0,0,10,0">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Apply from &#x25BE;" Padding="8,2" Margin="4,0" IsEnabled="{Binding HasApplyOptions}" Click="ApplyFrom_Click">
                <Button.ContextMenu>
                  <ContextMenu Style="{StaticResource ApplyFromMenu}" ItemsSource="{Binding ApplyFromOptions}">
                    <ContextMenu.ItemContainerStyle>
                      <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding ApplyCommand}" />
                      </Style>
                    </ContextMenu.ItemContainerStyle>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Content="Reset" Padding="8,2" Margin="4,0" Command="{Binding ResetCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SizeText}" Foreground="#888888" FontSize="11" />
              <TextBlock Text="{Binding StatusText}" FontSize="11" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </DockPanel>
</UserControl>

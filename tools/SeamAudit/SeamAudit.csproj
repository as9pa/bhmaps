  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BhMaps.Core\BhMaps.Core.csproj" />
  </ItemGroup>

</Project>
